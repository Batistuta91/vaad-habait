<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ממשק מנהל – <%= data.settings.buildingName %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-brand">
      <span class="logo">⚙️</span>
      <div>
        <h1><%= data.settings.buildingName %></h1>
        <p>ממשק ניהול מנהל</p>
      </div>
    </a>
    <div class="header-actions">
      <button class="btn btn-secondary btn-sm" id="adminLogoutBtn" style="display:none" onclick="adminLogout()">יציאה</button>
      <a href="/" class="btn btn-ghost btn-sm">← ממשק דיירים</a>
    </div>
  </div>
</header>

<!-- ADMIN LOGIN -->
<div id="adminLoginSection" class="login-screen">
  <div class="login-card">
    <div class="login-icon">🔐</div>
    <h2>כניסת מנהל</h2>
    <p>הזן סיסמת מנהל לגישה לפאנל הניהול</p>
    <div class="form-group">
      <input type="password" id="adminPassInput" class="form-control" placeholder="סיסמת מנהל" autofocus>
    </div>
    <div id="adminLoginError" class="alert alert-danger" style="display:none">סיסמה שגויה</div>
    <button class="btn btn-primary w-full btn-lg" onclick="doAdminLogin()">כניסה</button>
    <p class="text-sm text-muted mt-2">סיסמת ברירת מחדל: admin123</p>
  </div>
</div>

<!-- ADMIN PANEL -->
<div id="adminPanel" style="display:none;">
  <!-- Mobile tab nav -->
  <div class="mobile-tab-nav" id="mobileSideNav">
    <button class="tab-btn active" onclick="showAdminSection('dashboard', this)">📊 דשבורד</button>
    <button class="tab-btn" onclick="showAdminSection('residents', this)">🏠 דיירים</button>
    <button class="tab-btn" onclick="showAdminSection('transactions', this)">💰 גבייה</button>
    <button class="tab-btn" onclick="showAdminSection('deferred', this)">📅 צ׳קים</button>
    <button class="tab-btn" onclick="showAdminSection('projects', this)">🎯 פרויקטים</button>
    <button class="tab-btn" onclick="showAdminSection('expenses', this)">💸 הוצאות</button>
    <button class="tab-btn" onclick="showAdminSection('services', this)">🔧 ספקים</button>
    <button class="tab-btn" onclick="showAdminSection('settings', this)">⚙️ הגדרות</button>
  </div>

  <div class="admin-layout">
    <!-- Sidebar -->
    <div class="admin-sidebar" id="desktopSidebar">
      <div class="sidebar-nav">
        <div class="sidebar-group-title">ראשי</div>
        <button class="sidebar-item active" onclick="showAdminSection('dashboard', this)"><span class="sidebar-icon">📊</span> דשבורד</button>

        <div class="sidebar-group-title">ניהול</div>
        <button class="sidebar-item" onclick="showAdminSection('residents', this)"><span class="sidebar-icon">🏠</span> דיירים</button>
        <button class="sidebar-item" onclick="showAdminSection('transactions', this)"><span class="sidebar-icon">💰</span> גבייה שוטפת</button>
        <button class="sidebar-item" onclick="showAdminSection('deferred', this)"><span class="sidebar-icon">📅</span> המחאות דחויות</button>
        <button class="sidebar-item" onclick="showAdminSection('projects', this)"><span class="sidebar-icon">🎯</span> גבייה חד-פעמית</button>
        <button class="sidebar-item" onclick="showAdminSection('expenses', this)"><span class="sidebar-icon">💸</span> הוצאות</button>
        <button class="sidebar-item" onclick="showAdminSection('services', this)"><span class="sidebar-icon">🔧</span> ספקים ועסקאות</button>

        <div class="sidebar-group-title">מערכת</div>
        <button class="sidebar-item" onclick="showAdminSection('balance', this)"><span class="sidebar-icon">🏦</span> יתרת פתיחה</button>
        <button class="sidebar-item" onclick="showAdminSection('settings', this)"><span class="sidebar-icon">⚙️</span> הגדרות</button>
        <div class="sidebar-group-title">ייצוא</div>
        <button class="sidebar-item" onclick="exportData('transactions')"><span class="sidebar-icon">📥</span> ייצוא תנועות</button>
        <button class="sidebar-item" onclick="exportData('residents')"><span class="sidebar-icon">📥</span> ייצוא דיירים</button>
      </div>
    </div>

    <!-- Main content -->
    <div class="admin-content" id="adminContent">
      <!-- Dashboard -->
      <div id="sec-dashboard" class="admin-section">
        <h2 class="mb-3">📊 דשבורד ראשי</h2>
        <div id="dashboardContent"></div>
      </div>

      <!-- Residents -->
      <div id="sec-residents" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>🏠 ניהול דיירים</h2>
          <button class="btn btn-primary" onclick="openResidentModal()">+ הוסף דייר</button>
        </div>
        <div id="residentsContent"></div>
      </div>

      <!-- Transactions -->
      <div id="sec-transactions" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>💰 גבייה שוטפת</h2>
          <button class="btn btn-primary" onclick="openTransactionModal()">+ רשום תשלום</button>
        </div>
        <div id="transactionsContent"></div>
      </div>

      <!-- Deferred Checks -->
      <div id="sec-deferred" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>📅 המחאות דחויות</h2>
          <button class="btn btn-primary" onclick="openDeferredModal()">+ הוסף המחאה</button>
        </div>
        <div id="deferredContent"></div>
      </div>

      <!-- One-time projects -->
      <div id="sec-projects" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>🎯 גבייה חד-פעמית</h2>
          <button class="btn btn-primary" onclick="openProjectModal()">+ פרויקט חדש</button>
        </div>
        <div id="projectsContent"></div>
      </div>

      <!-- Expenses -->
      <div id="sec-expenses" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>💸 הוצאות</h2>
          <button class="btn btn-primary" onclick="openExpenseModal()">+ הוצאה חדשה</button>
        </div>
        <div id="expensesContent"></div>
      </div>

      <!-- Services -->
      <div id="sec-services" class="admin-section hidden">
        <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px;">
          <h2>🔧 ספקים ועסקאות שירות</h2>
          <button class="btn btn-primary" onclick="openServiceModal()">+ עסקת שירות</button>
        </div>
        <div id="servicesContent"></div>
      </div>

      <!-- Balance -->
      <div id="sec-balance" class="admin-section hidden">
        <h2 class="mb-3">🏦 יתרת פתיחה והכנסות חוץ</h2>
        <div id="balanceContent"></div>
      </div>

      <!-- Settings -->
      <div id="sec-settings" class="admin-section hidden">
        <h2 class="mb-3">⚙️ הגדרות מערכת</h2>
        <div id="settingsContent"></div>
      </div>
    </div>
  </div>
</div>

<!-- ========== MODALS ========== -->

<!-- Resident Modal -->
<div class="modal-overlay" id="residentModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="residentModalTitle">הוספת דייר</div>
      <button class="modal-close" onclick="closeModal('residentModal')">✕</button>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">מספר דירה</label><input type="number" id="rNumber" class="form-control" min="1" max="99"></div>
      <div class="form-group">
        <label class="form-label">סוג דירה</label>
        <select id="rTypeId" class="form-control"></select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">שם משפחה</label><input id="rLastName" class="form-control" type="text"></div>
      <div class="form-group"><label class="form-label">שם פרטי</label><input id="rFirstName" class="form-control" type="text"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">טלפון</label><input id="rPhone" class="form-control" type="tel"></div>
      <div class="form-group"><label class="form-label">תאריך כניסה</label><input id="rEntryDate" class="form-control" type="date"></div>
    </div>
    <div class="form-group"><label class="form-label">סיסמת גישה לדייר</label><input id="rPassword" class="form-control" type="text" placeholder="לדוגמה: 1234"></div>
    <div class="form-group">
      <div class="toggle-wrap">
        <label class="toggle"><input type="checkbox" id="rIsRental" onchange="toggleRentalFields()"><span class="toggle-slider"></span></label>
        <label class="form-label" style="margin-bottom:0">דירה בשכירות</label>
      </div>
    </div>
    <div id="rentalFields" style="display:none">
      <div class="form-row">
        <div class="form-group"><label class="form-label">שם בעל הנכס</label><input id="rOwnerName" class="form-control" type="text"></div>
        <div class="form-group"><label class="form-label">טלפון בעל הנכס</label><input id="rOwnerPhone" class="form-control" type="tel"></div>
      </div>
    </div>
    <div class="form-group"><label class="form-label">הערה לדייר</label><textarea id="rNote" class="form-control" rows="2" placeholder="הודעה אישית שתופיע באזור האישי של הדייר"></textarea></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveResident()">שמור</button>
      <button class="btn btn-secondary" onclick="closeModal('residentModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Transaction Modal -->
<div class="modal-overlay" id="transactionModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">רישום תשלום</div>
      <button class="modal-close" onclick="closeModal('transactionModal')">✕</button>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">דירה</label>
        <select id="tAptId" class="form-control" onchange="autoFillAmount()"></select>
      </div>
      <div class="form-group">
        <label class="form-label">אמצעי תשלום</label>
        <select id="tMethod" class="form-control">
          <option value="cash">מזומן</option>
          <option value="check">צ'ק שוטף</option>
          <option value="transfer">העברה</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">סכום (₪)</label><input id="tAmount" class="form-control" type="number" min="0"></div>
      <div class="form-group">
        <label class="form-label">מספר חודשים לתשלום</label>
        <input id="tMonths" class="form-control" type="number" min="1" max="24" value="1" onchange="updateMultiMonth()">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">חודש תחילה</label>
        <select id="tMonth" class="form-control"></select>
      </div>
      <div class="form-group"><label class="form-label">שנה</label><input id="tYear" class="form-control" type="number" min="2020" max="2030"></div>
    </div>
    <div class="form-group"><label class="form-label">פירוט (אופציונלי)</label><input id="tNote" class="form-control" type="text" placeholder="לדוגמה: חודשים ינואר-מרץ 2024"></div>
    <div id="multiMonthPreview" class="alert alert-info" style="display:none;margin-top:8px;"></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveTransaction()">שמור ✓</button>
      <button class="btn btn-success" onclick="saveAndPrintReceipt()">שמור + קבלה 🖨️</button>
      <button class="btn btn-secondary" onclick="closeModal('transactionModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Deferred Check Modal -->
<div class="modal-overlay" id="deferredModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">הוספת המחאה דחויה</div>
      <button class="modal-close" onclick="closeModal('deferredModal')">✕</button>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">דירה</label>
        <select id="dAptId" class="form-control" onchange="autoFillDeferred()"></select>
      </div>
      <div class="form-group"><label class="form-label">מספר המחאה</label><input id="dCheckNum" class="form-control" type="text"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">סכום כל המחאה (₪)</label><input id="dAmount" class="form-control" type="number" min="0"></div>
      <div class="form-group">
        <label class="form-label">כמה חודשים?</label>
        <input id="dNumMonths" class="form-control" type="number" min="1" max="24" value="1" onchange="buildDeferredPreview()">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">חודש פירעון ראשון</label>
        <select id="dStartMonth" class="form-control" onchange="buildDeferredPreview()"></select>
      </div>
      <div class="form-group"><label class="form-label">שנה</label><input id="dStartYear" class="form-control" type="number" min="2024" max="2030" onchange="buildDeferredPreview()"></div>
    </div>
    <div id="deferredPreview" class="alert alert-info" style="display:none;margin-top:8px;"></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveDeferred()">שמור</button>
      <button class="btn btn-secondary" onclick="closeModal('deferredModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Project Modal -->
<div class="modal-overlay" id="projectModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">פרויקט גבייה חד-פעמית</div>
      <button class="modal-close" onclick="closeModal('projectModal')">✕</button>
    </div>
    <div class="form-group"><label class="form-label">שם הפרויקט</label><input id="pName" class="form-control" type="text" placeholder="לדוגמה: זיפות גג 2024"></div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">סכום לדירה (₪)</label><input id="pAmount" class="form-control" type="number" min="0"></div>
      <div class="form-group"><label class="form-label">תאריך יעד</label><input id="pDueDate" class="form-control" type="date"></div>
    </div>
    <div class="form-group"><label class="form-label">פירוט</label><textarea id="pNote" class="form-control" rows="2"></textarea></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveProject()">צור פרויקט</button>
      <button class="btn btn-secondary" onclick="closeModal('projectModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Expense Modal -->
<div class="modal-overlay" id="expenseModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">הוצאה חדשה</div>
      <button class="modal-close" onclick="closeModal('expenseModal')">✕</button>
    </div>
    <div class="form-group">
      <label class="form-label">עסקת שירות (ספק)</label>
      <select id="eServiceId" class="form-control">
        <option value="">-- ללא ספק ספציפי --</option>
      </select>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">סכום (₪)</label><input id="eAmount" class="form-control" type="number" min="0"></div>
      <div class="form-group">
        <label class="form-label">חודש</label>
        <select id="eMonth" class="form-control"></select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">שנה</label><input id="eYear" class="form-control" type="number" min="2020" max="2030"></div>
      <div class="form-group">
        <label class="form-label">אמצעי תשלום</label>
        <select id="eMethod" class="form-control">
          <option value="transfer">העברה</option>
          <option value="cash">מזומן</option>
          <option value="check">צ'ק</option>
        </select>
      </div>
    </div>
    <div class="form-group"><label class="form-label">פירוט</label><input id="eNote" class="form-control" type="text" placeholder="פירוט ההוצאה"></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveExpense()">שמור</button>
      <button class="btn btn-secondary" onclick="closeModal('expenseModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Service Transaction Modal -->
<div class="modal-overlay" id="serviceModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="serviceModalTitle">עסקת שירות חדשה</div>
      <button class="modal-close" onclick="closeModal('serviceModal')">✕</button>
    </div>
    <div class="form-group"><label class="form-label">שם העסקה</label><input id="svName" class="form-control" type="text" placeholder="לדוגמה: אחזקה שנתית – מעלית"></div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">מקצוע</label>
        <select id="svProfession" class="form-control"></select>
      </div>
      <div class="form-group">
        <label class="form-label">מצב עבודה</label>
        <select id="svStatus" class="form-control"></select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">טלפון ספק</label><input id="svPhone" class="form-control" type="tel"></div>
      <div class="form-group"><label class="form-label">עלות כוללת (₪)</label><input id="svTotalCost" class="form-control" type="number" min="0"></div>
    </div>
    <div class="form-group">
      <div class="toggle-wrap">
        <label class="toggle"><input type="checkbox" id="svIsRetainer"><span class="toggle-slider"></span></label>
        <label class="form-label" style="margin-bottom:0">שירות קבוע (ריטיינר)</label>
      </div>
    </div>
    <div class="form-group"><label class="form-label">הערות</label><textarea id="svNote" class="form-control" rows="2"></textarea></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveService()">שמור</button>
      <button class="btn btn-secondary" onclick="closeModal('serviceModal')">ביטול</button>
    </div>
  </div>
</div>

<!-- Receipt Modal -->
<div class="modal-overlay" id="receiptModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">🧾 קבלה דיגיטלית</div>
      <button class="modal-close" onclick="closeModal('receiptModal')">✕</button>
    </div>
    <div id="receiptContent"></div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="window.print()">🖨️ הדפסה</button>
      <button class="btn btn-secondary" onclick="closeModal('receiptModal')">סגור</button>
    </div>
  </div>
</div>

<div id="toast-container"></div>

<script>
// ═══════════════════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════════════════
let appData = <%- JSON.stringify(data) %>;
let editingId = null;
const MONTHS = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
const nowDate = new Date();

// ═══════════════════════════════════════════════════════════════
//  AUTH
// ═══════════════════════════════════════════════════════════════
function doAdminLogin() {
  const pw = document.getElementById('adminPassInput').value;
  fetch('/api/auth/admin', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ password: pw })
  }).then(r => r.json()).then(res => {
    if (res.error) { document.getElementById('adminLoginError').style.display = 'flex'; return; }
    localStorage.setItem('adminSession', '1');
    document.getElementById('adminLoginSection').style.display = 'none';
    document.getElementById('adminPanel').style.display = 'block';
    document.getElementById('adminLogoutBtn').style.display = 'inline-flex';
    initAdmin();
  });
}

function adminLogout() {
  localStorage.removeItem('adminSession');
  location.reload();
}

document.getElementById('adminPassInput').addEventListener('keydown', e => { if(e.key==='Enter') doAdminLogin(); });

if (localStorage.getItem('adminSession')) {
  document.getElementById('adminLoginSection').style.display = 'none';
  document.getElementById('adminPanel').style.display = 'block';
  document.getElementById('adminLogoutBtn').style.display = 'inline-flex';
  initAdmin();
}

// ═══════════════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════════════
function initAdmin() {
  populateMonthSelects();
  renderDashboard();
  renderResidents();
  renderTransactions();
  renderDeferred();
  renderProjects();
  renderExpenses();
  renderServices();
  renderBalance();
  renderSettings();
}

async function refreshData() {
  const res = await fetch('/api/data');
  appData = await res.json();
}

// ═══════════════════════════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════════════════════════
function showAdminSection(name, btn) {
  document.querySelectorAll('.admin-section').forEach(s => s.classList.add('hidden'));
  document.querySelectorAll('.sidebar-item, .mobile-tab-nav .tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(`sec-${name}`).classList.remove('hidden');
  if (btn) btn.classList.add('active');
}

// ═══════════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════════
function renderDashboard() {
  const totalIncome = appData.transactions
    .filter(t => t.type === 'income' && !t.canceled)
    .reduce((s, t) => s + Number(t.amount), 0);

  const totalExpenses = appData.transactions
    .filter(t => t.type === 'expense' && !t.canceled)
    .reduce((s, t) => s + Number(t.amount), 0);

  const deferredPending = appData.deferredChecks
    .filter(d => !d.cashed)
    .reduce((s, d) => s + Number(d.amount), 0);

  const openBank = Number(appData.openingBalance?.bank || 0);
  const openCash = Number(appData.openingBalance?.cash || 0);
  const extIncome = appData.externalIncome.reduce((s, x) => s + Number(x.amount), 0);

  const totalFund = openBank + openCash + totalIncome + extIncome - totalExpenses;

  // Debt residents
  const debtors = appData.residents.filter(r => {
    const balance = calcResidentBalance(r);
    return balance < 0;
  });

  const upcomingChecks = appData.deferredChecks
    .filter(d => !d.cashed)
    .sort((a,b) => new Date(a.dueDate) - new Date(b.dueDate))
    .slice(0, 5);

  let html = `
  <div class="grid grid-4 mb-3" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
    <div class="stat-card">
      <div class="stat-label">💰 יתרה כוללת בקופה</div>
      <div class="stat-value ${totalFund < 0 ? 'danger' : 'success'}">₪${Math.abs(totalFund).toLocaleString()}</div>
      <div class="stat-sub">${totalFund < 0 ? 'גירעון!' : 'יתרה חיובית'}</div>
    </div>
    <div class="stat-card warning">
      <div class="stat-label">📅 צ׳קים דחויים ממתינים</div>
      <div class="stat-value">₪${deferredPending.toLocaleString()}</div>
      <div class="stat-sub">${appData.deferredChecks.filter(d=>!d.cashed).length} המחאות</div>
    </div>
    <div class="stat-card danger">
      <div class="stat-label">⚠️ דיירים עם חוב</div>
      <div class="stat-value danger">${debtors.length}</div>
      <div class="stat-sub">מתוך ${appData.residents.length} דירות</div>
    </div>
    <div class="stat-card gold">
      <div class="stat-label">💸 סה"כ הוצאות</div>
      <div class="stat-value">₪${totalExpenses.toLocaleString()}</div>
      <div class="stat-sub">מתוך גבייה: ₪${totalIncome.toLocaleString()}</div>
    </div>
  </div>

  <div class="grid grid-2">
    <div class="card">
      <div class="card-header"><div class="card-title">⚠️ דיירים עם חוב</div></div>`;

  if (debtors.length === 0) {
    html += '<div class="alert alert-success">✅ כל הדיירים מעודכנים!</div>';
  } else {
    html += '<div class="table-wrap"><table><thead><tr><th>דירה</th><th>שם</th><th>חוב</th></tr></thead><tbody>';
    debtors.forEach(r => {
      const bal = calcResidentBalance(r);
      html += `<tr><td><strong>דירה ${r.number}</strong></td><td>${r.lastName} ${r.firstName}</td><td class="text-danger text-bold">₪${Math.abs(bal).toLocaleString()}</td></tr>`;
    });
    html += '</tbody></table></div>';
  }

  html += `</div>
    <div class="card">
      <div class="card-header"><div class="card-title">📅 צ׳קים קרובים לפירעון</div></div>`;

  if (upcomingChecks.length === 0) {
    html += '<div class="empty-state" style="padding:24px"><p>אין צ׳קים ממתינים</p></div>';
  } else {
    html += '<div class="table-wrap"><table><thead><tr><th>דירה</th><th>סכום</th><th>תאריך פירעון</th></tr></thead><tbody>';
    upcomingChecks.forEach(d => {
      const r = appData.residents.find(r => String(r.number) === String(d.aptNumber));
      const dueSoon = new Date(d.dueDate) <= new Date(Date.now() + 30*24*60*60*1000);
      html += `<tr><td>דירה ${d.aptNumber}</td><td>₪${Number(d.amount).toLocaleString()}</td>
        <td class="${dueSoon ? 'text-warning text-bold' : ''}">${formatDate(d.dueDate)}</td></tr>`;
    });
    html += '</tbody></table></div>';
  }

  html += `</div></div>`;
  document.getElementById('dashboardContent').innerHTML = html;
}

function calcResidentBalance(resident) {
  const aptType = appData.settings.apartmentTypes.find(t => t.id === resident.typeId);
  const monthly = aptType ? Number(aptType.monthlyFee) : 0;
  const income = appData.transactions
    .filter(t => String(t.aptNumber) === String(resident.number) && t.type === 'income' && !t.canceled)
    .reduce((s, t) => s + Number(t.amount), 0);
  const deferred = appData.deferredChecks
    .filter(d => String(d.aptNumber) === String(resident.number) && d.cashed)
    .reduce((s, d) => s + Number(d.amount), 0);
  const entry = new Date(resident.entryDate || '2020-01-01');
  const now = new Date();
  const months = (now.getFullYear() - entry.getFullYear()) * 12 + (now.getMonth() - entry.getMonth()) + 1;
  return (income + deferred) - (months * monthly);
}

