<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ממשק מנהל — <%= buildingName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script>if(localStorage.getItem('vaad_theme')==='light') document.documentElement.classList.add('pre-light');</script>
  <style>.pre-light body{background:#f5f6fa!important;}</style>
  <style>
  /* ── TABS ── */
  .tabs{display:flex;gap:6px;margin-bottom:24px;flex-wrap:wrap;}
  .tab-btn{padding:10px 20px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg2);color:var(--text-muted);font-family:'Heebo',sans-serif;font-size:0.88rem;font-weight:600;cursor:pointer;transition:var(--transition);text-align:center;}
  .tab-btn.active{background:var(--gold);color:#111;border-color:var(--gold);}
  .tab-pane{display:none;}.tab-pane.active{display:block;}

  /* ── MATRIX ── */
  .matrix-wrapper{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .matrix-table{border-collapse:collapse;font-size:0.8rem;min-width:700px;width:100%;}
  .matrix-table th{background:var(--bg);color:var(--text-muted);padding:9px 5px;text-align:center;border:1px solid var(--border);white-space:nowrap;font-size:0.72rem;font-weight:700;}
  .matrix-table td{border:1px solid var(--border);padding:0;text-align:center;vertical-align:middle;}
  .matrix-table .apt-th{text-align:right;padding:8px 12px;white-space:nowrap;font-weight:600;min-width:100px;background:var(--bg2);}
  .apt-th .apt-owner{font-size:0.7rem;color:var(--text-muted);display:block;margin-top:2px;}

  /* pay cell — 3 states */
  .pay-cell{
    width:100%;height:40px;display:flex;align-items:center;justify-content:center;
    cursor:pointer;transition:background 0.15s;user-select:none;font-size:0.78rem;
    font-weight:700;position:relative;flex-direction:column;gap:1px;
  }
  .pay-cell.full {background:rgba(22,163,74,0.18);color:var(--green);}
  .pay-cell.partial{background:rgba(245,200,66,0.18);color:var(--gold);}
  .pay-cell.unpaid {background:rgba(239,68,68,0.08);color:var(--text-dim);}
  .pay-cell.future {background:var(--bg3);color:var(--text-dim);cursor:default;font-size:0.7rem;}
  .pay-cell:not(.future):hover{opacity:0.75;}
  .pay-cell .cell-amount{font-size:0.65rem;opacity:0.8;}

  /* partial-amount popup */
  .partial-popup{
    display:none;position:fixed;z-index:200;
    background:var(--card);border:1px solid var(--border-strong);
    border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-lg);
    min-width:220px;text-align:right;
  }
  .partial-popup.show{display:block;}
  .partial-popup h4{font-size:0.9rem;font-weight:700;margin-bottom:12px;color:var(--text);}
  .partial-popup input{
    width:100%;background:var(--bg2);border:1px solid var(--border-strong);
    border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;
    font-size:1rem;padding:10px 12px;direction:rtl;margin-bottom:10px;
  }
  .partial-popup input:focus{outline:none;border-color:var(--gold);}
  .partial-popup .popup-btns{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;}

  /* year tabs */
  .year-tab-row{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap;}
  .year-tab{padding:7px 18px;border-radius:50px;border:1px solid var(--border);background:var(--bg2);color:var(--text-muted);font-size:0.85rem;font-weight:600;cursor:pointer;transition:var(--transition);}
  .year-tab.active{background:var(--blue);color:#fff;border-color:var(--blue);}

  /* apt table */
  .apt-table-wrap{overflow-x:auto;}
  .apt-grid{display:grid;grid-template-columns:44px 1fr 1fr 140px 1fr 110px;gap:8px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--border);}
  .apt-grid.hdr{background:var(--bg);color:var(--text-muted);font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;border-radius:var(--radius-sm) var(--radius-sm) 0 0;}
  .apt-grid input{background:var(--bg2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.85rem;padding:8px 10px;width:100%;direction:rtl;transition:var(--transition);}
  .apt-grid input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 2px var(--gold-dim);}
  .apt-grid:hover:not(.hdr){background:rgba(255,255,255,0.02);}
  @media(max-width:800px){.apt-grid{grid-template-columns:38px 1fr 1fr 120px;} .apt-grid .col-note,.apt-grid .col-status{display:none;}.apt-grid.hdr .col-note,.apt-grid.hdr .col-status{display:none;}}
  @media(max-width:520px){.apt-grid{grid-template-columns:34px 1fr;} .apt-grid .col-pass,.apt-grid .col-pw{display:none;}.apt-grid.hdr .col-pass,.apt-grid.hdr .col-pw{display:none;}}

  /* special charges */
  .sc-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:14px;}
  .sc-hdr{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px;}
  .sc-hdr input{background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.88rem;padding:8px 11px;direction:rtl;transition:var(--transition);}
  .sc-hdr input:focus{outline:none;border-color:var(--blue);}
  .sc-chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px;}
  .sc-chip{display:flex;align-items:center;gap:4px;padding:5px 11px;border-radius:50px;font-size:0.8rem;font-weight:600;cursor:pointer;user-select:none;transition:var(--transition);border:1px solid var(--border);background:var(--bg3);color:var(--text-muted);}
  .sc-chip.paid{background:var(--green-dim);color:var(--green);border-color:rgba(22,163,74,0.35);}

  /* settings */
  .settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media(max-width:560px){.settings-grid{grid-template-columns:1fr;}}
  .settings-grid input{width:100%;background:var(--bg2);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.9rem;padding:10px 12px;direction:rtl;transition:var(--transition);}
  .settings-grid input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 2px var(--gold-dim);}

  /* summary */
  .sum-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-bottom:24px;}
  .sum-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px;text-align:center;}
  .sum-val{font-size:1.5rem;font-weight:900;font-family:'Frank Ruhl Libre',serif;}
  .sum-lbl{font-size:0.73rem;color:var(--text-muted);margin-top:3px;}

  .add-row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;background:var(--bg2);border:1px dashed var(--border-strong);border-radius:var(--radius);padding:18px;margin-bottom:18px;}
  .add-row .fg{flex:1;min-width:120px;display:flex;flex-direction:column;gap:5px;}
  .add-row .fg label{font-size:0.78rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;}
  .add-row .fg input{background:var(--bg);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.9rem;padding:9px 12px;direction:rtl;width:100%;}
  .add-row .fg input:focus{outline:none;border-color:var(--gold);}

  .info-tip{display:inline-flex;align-items:center;gap:8px;background:var(--blue-dim);border:1px solid rgba(99,102,241,0.25);color:var(--blue);border-radius:var(--radius-sm);padding:10px 16px;font-size:0.83rem;font-weight:600;margin-bottom:16px;direction:rtl;text-align:right;}

  /* legend */
  .legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;font-size:0.8rem;align-items:center;}
  .leg-dot{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:50px;}
  .leg-full{background:rgba(22,163,74,0.15);color:var(--green);}
  .leg-partial{background:rgba(245,200,66,0.15);color:var(--gold);}
  .leg-unpaid{background:rgba(239,68,68,0.08);color:var(--red);}
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🔐</div>
      <div class="logo-text">ממשק מנהל<span><%= buildingName %></span></div>
    </div>
    <nav class="header-nav" style="display:flex;align-items:center;gap:10px;">
      <button class="theme-toggle" id="theme-toggle-btn">
        <span id="theme-icon">🌙</span>
        <div class="toggle-track"><div class="toggle-thumb"></div></div>
        <span id="theme-label">כהה</span>
      </button>
      <a href="/">← דיירים</a>
    </nav>
  </div>
</header>

<!-- LOGIN OVERLAY -->
<div id="admin-login-overlay" class="admin-login-overlay">
  <div class="admin-login-box">
    <span class="lock-icon">🔐</span>
    <h2>כניסת ועד בית</h2>
    <p>אזור מוגן — הזן סיסמת מנהל</p>
    <p style="font-size:0.8rem;color:var(--gold);margin-bottom:16px;">סיסמת ברירת מחדל: <strong>vaad2024</strong></p>
    <div class="form-group" style="text-align:right;">
      <label>סיסמת מנהל</label>
      <input type="password" id="admin-pass-input" placeholder="הזן סיסמה"
        style="width:100%;background:var(--bg);border:1px solid var(--border-strong);border-radius:8px;color:var(--text);font-family:Heebo,sans-serif;font-size:1rem;padding:12px 14px;direction:rtl;margin-top:6px;">
    </div>
    <div id="admin-login-error" style="color:var(--red);font-size:0.85rem;margin:10px 0;display:none;padding:8px 12px;background:var(--red-dim);border-radius:6px;"></div>
    <button class="btn btn-primary btn-full mt-12" id="admin-login-btn">כניסה למערכת</button>
  </div>
</div>

<!-- ADMIN PANEL -->
<div id="admin-panel">
  <div class="page-hero">
    <h1>ניהול <span>ועד הבית</span></h1>
    <p>שליטה מלאה על כל הנתונים</p>
  </div>

  <div class="container">

    <!-- SUMMARY -->
    <div class="sum-cards">
      <div class="sum-card"><div class="sum-val" id="sum-clean" style="color:var(--green);">—</div><div class="sum-lbl">דירות ללא חוב</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-owed"  style="color:var(--red);">—</div><div class="sum-lbl">דירות עם חוב</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-total" style="color:var(--gold);">—</div><div class="sum-lbl">חוב כולל (₪)</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-collected" style="color:var(--blue);">—</div><div class="sum-lbl">נגבה (₪)</div></div>
    </div>

    <!-- TABS -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="payments">📅 תשלומים חודשיים</button>
      <button class="tab-btn" data-tab="apartments">🏠 דירות ופרטים</button>
      <button class="tab-btn" data-tab="special">⚡ גביות מיוחדות</button>
      <button class="tab-btn" data-tab="settings">⚙️ הגדרות</button>
    </div>

    <!-- ── TAB: PAYMENTS ───────────────────────────────────────────── -->
    <div class="tab-pane active" id="tab-payments">

      <div class="legend">
        <span class="leg-dot leg-full">✓ שולם מלא</span>
        <span class="leg-dot leg-partial">~ תשלום חלקי</span>
        <span class="leg-dot leg-unpaid">✗ לא שולם</span>
        <span class="text-muted" style="font-size:0.78rem;margin-right:auto;">לחיצה ימנית / לחיצה ארוכה = הזן סכום חלקי</span>
      </div>

      <div class="year-tab-row" id="year-tabs">
        <% years.forEach(y=>{ %>
        <button class="year-tab <%= y===currentYear?'active':'' %>" data-year="<%= y %>"><%= y %></button>
        <% }) %>
        <button class="btn btn-outline btn-sm" id="add-year-btn">+ שנה חדשה</button>
      </div>

      <div class="card" style="padding:0;">
        <div class="matrix-wrapper">
          <table class="matrix-table" id="payments-matrix">
            <thead>
              <tr>
                <th class="apt-th" style="text-align:right;padding:9px 12px;">דירה</th>
                <% ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'].forEach(m=>{ %>
                <th><%= m %></th>
                <% }) %>
                <th>יתרת חוב</th>
              </tr>
            </thead>
            <tbody id="matrix-body"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── TAB: APARTMENTS ──────────────────────────────────────────── -->
    <div class="tab-pane" id="tab-apartments">
      <div class="card" style="padding:0;">
        <div class="apt-table-wrap">
          <div class="apt-grid hdr">
            <div>#</div>
            <div>שם בעל הדירה</div>
            <div class="col-pass">סיסמה חדשה</div>
            <div class="col-pw">סיסמה נוכחית</div>
            <div class="col-note">הערה לדייר</div>
            <div class="col-status">סטטוס</div>
          </div>
          <% apartments.forEach(apt=>{ %>
          <div class="apt-grid" data-apt-id="<%= apt.id %>">
            <div><span class="apt-id-tag"><%= apt.id %></span></div>
            <div><input type="text" class="owner-input" value="<%= apt.ownerName||'' %>" placeholder="שם בעל הדירה"></div>
            <div class="col-pass"><input type="text" class="pass-input" value="" placeholder="סיסמה חדשה (4+ תווים)"></div>
            <div class="col-pw" style="display:flex;align-items:center;gap:6px;">
              <span style="font-size:0.78rem;color:var(--text-dim);" id="cur-pass-<%= apt.id %>">•••</span>
              <button class="btn btn-ghost btn-sm show-pass-btn" data-pass="<%= apt.password %>" data-id="<%= apt.id %>" style="font-size:0.75rem;padding:4px 8px;">הצג</button>
            </div>
            <div class="col-note"><input type="text" class="note-input" value="<%= apt.note||'' %>" placeholder="הערה..."></div>
            <div class="col-status"><span class="badge" id="row-status-<%= apt.id %>">—</span></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ── TAB: SPECIAL CHARGES ─────────────────────────────────────── -->
    <div class="tab-pane" id="tab-special">
      <div class="add-row">
        <div class="fg"><label>שם הגבייה</label><input type="text" id="sc-name" placeholder="פיצוץ צינור, תיקון..."></div>
        <div class="fg"><label>תיאור</label><input type="text" id="sc-desc" placeholder="תיאור קצר"></div>
        <div class="fg" style="max-width:140px;"><label>עלות לדירה (₪)</label><input type="number" id="sc-cost" placeholder="0" min="0"></div>
        <div class="fg" style="max-width:160px;"><label>תאריך</label><input type="date" id="sc-date" style="background:var(--bg);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-size:0.9rem;padding:9px 12px;width:100%;"></div>
        <div class="fg" style="flex:none;"><label style="visibility:hidden;">add</label><button class="btn btn-green" id="add-sc-btn">+ הוסף</button></div>
      </div>
      <div id="sc-list">
        <% specialCharges.forEach(sc=>{ %>
        <div class="sc-card" id="sc-card-<%= sc.id %>" data-sc-id="<%= sc.id %>">
          <div class="sc-hdr">
            <input type="text"   class="sc-name" value="<%= sc.name %>" placeholder="שם" style="flex:2;min-width:130px;">
            <input type="text"   class="sc-desc" value="<%= sc.description||'' %>" placeholder="תיאור" style="flex:2;min-width:130px;">
            <input type="number" class="sc-cost" value="<%= sc.costPerApartment %>" min="0" style="width:100px;">
            <input type="date"   class="sc-date" value="<%= sc.date||'' %>" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;padding:7px 10px;width:140px;">
            <button class="btn btn-danger btn-sm delete-sc-btn">🗑</button>
          </div>
          <div class="text-muted text-small" style="margin-bottom:8px;">לחץ על דירה לסימון תשלום:</div>
          <div class="sc-chips">
            <% for(let i=1;i<=20;i++){
               const entry=sc.apartments.find(a=>a.id===i);
               const isPaid=entry&&entry.paid; %>
            <div class="sc-chip <%= isPaid?'paid':'' %>" data-apt="<%= i %>"><%= isPaid?'✓':'○' %> דירה <%= i %></div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- ── TAB: SETTINGS ────────────────────────────────────────────── -->
    <div class="tab-pane" id="tab-settings">
      <div class="card" style="margin-bottom:16px;">
        <h3 class="section-title" style="margin-bottom:20px;">פרטי הבניין</h3>
        <div class="settings-grid">
          <div class="form-group"><label>שם הבניין</label><input type="text" id="set-bname" value="<%= buildingName %>"></div>
          <div class="form-group"><label>כתובת הבניין</label><input type="text" id="set-baddress" value="<%= buildingAddress %>"></div>
          <div class="form-group"><label>ועד חודשי (₪)</label><input type="number" id="set-fee" value="<%= monthlyFee %>"></div>
        </div>
      </div>
      <div class="card" style="margin-bottom:16px;">
        <h3 class="section-title" style="margin-bottom:20px;">פרטי בנק ו-PayBox</h3>
        <div class="settings-grid">
          <div class="form-group"><label>שם הבנק</label><input type="text" id="set-bank" value="<%= bankDetails.bank %>"></div>
          <div class="form-group"><label>סניף</label><input type="text" id="set-branch" value="<%= bankDetails.branch %>"></div>
          <div class="form-group"><label>מספר חשבון</label><input type="text" id="set-account" value="<%= bankDetails.account %>"></div>
          <div class="form-group"><label>שם הנהנה</label><input type="text" id="set-beneficiary" value="<%= bankDetails.beneficiary %>"></div>
        </div>
        <div class="form-group mt-12">
          <label>קישור PayBox</label>
          <input type="text" id="set-paybox" value="<%= payboxLink %>" style="width:100%;background:var(--bg2);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:Heebo,sans-serif;font-size:0.9rem;padding:10px 12px;direction:rtl;">
        </div>
      </div>
      <div class="card">
        <h3 class="section-title" style="margin-bottom:20px;">שינוי סיסמת מנהל</h3>
        <div class="settings-grid">
          <div class="form-group"><label>סיסמה חדשה (4+ תווים)</label><input type="password" id="set-new-admin-pass" placeholder="השאר ריק כדי לא לשנות"></div>
          <div class="form-group"><label>אימות סיסמה חדשה</label><input type="password" id="set-new-admin-pass2" placeholder="הזן שוב"></div>
        </div>
        <p class="text-muted mt-8" style="font-size:0.82rem;">⚠️ לאחר שינוי הסיסמה תצטרך להתחבר מחדש.</p>
      </div>
    </div>

  </div><!-- /container -->

  <div class="save-bar">
    <span class="text-muted" style="align-self:center;font-size:0.83rem;">Ctrl+S לשמירה מהירה</span>
    <button class="btn btn-primary" id="save-all-btn">💾 שמור הכל</button>
  </div>
</div><!-- /#admin-panel -->

<!-- PARTIAL PAYMENT POPUP -->
<div class="partial-popup" id="partial-popup">
  <h4 id="popup-title">הזן סכום ששולם</h4>
  <input type="number" id="popup-amount" placeholder="₪" min="0" inputmode="numeric">
  <div class="popup-btns">
    <button class="btn btn-ghost btn-sm" id="popup-cancel">ביטול</button>
    <button class="btn btn-danger btn-sm" id="popup-clear">לא שולם</button>
    <button class="btn btn-primary btn-sm" id="popup-save">שמור</button>
  </div>
</div>
<div id="popup-overlay" style="display:none;position:fixed;inset:0;z-index:199;"></div>

<div class="toast" id="toast"></div>

<script>
// ═══ STATE ════════════════════════════════════════════════════════════════
let adminPassword = '';
let currentYear   = <%= currentYear %>;
let currentMonth  = <%= currentMonth %>;
let activeYear    = <%= currentYear %>;
const serverApartments = <%- JSON.stringify(apartments) %>;
const serverYears      = <%- JSON.stringify(years) %>;
const serverMonthlyFee = <%= monthlyFee %>;

// payments[aptId][key] = number (amount paid, 0=unpaid, full=serverMonthlyFee)
let payments = {};
serverApartments.forEach(a=>{
  payments[a.id]={};
  const raw=a.payments||{};
  Object.keys(raw).forEach(k=>{
    // migrate old boolean format
    if(typeof raw[k]==='boolean') payments[a.id][k]=raw[k]?serverMonthlyFee:0;
    else payments[a.id][k]=raw[k];
  });
});

// ═══ THEME ════════════════════════════════════════════════════════════════
(function(){applyTheme(localStorage.getItem('vaad_theme')||'dark');})();
function applyTheme(mode){
  document.body.classList.toggle('light',mode==='light');
  const icon=document.getElementById('theme-icon'),label=document.getElementById('theme-label');
  if(icon)  icon.textContent =mode==='light'?'☀️':'🌙';
  if(label) label.textContent=mode==='light'?'בהיר':'כהה';
  localStorage.setItem('vaad_theme',mode);
}
document.getElementById('theme-toggle-btn').addEventListener('click',()=>{
  applyTheme(document.body.classList.contains('light')?'dark':'light');
});

// ═══ TOAST ════════════════════════════════════════════════════════════════
function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg;t.className=`toast show ${type}`;
  setTimeout(()=>{t.className='toast';},3200);
}

// ═══ TABS ══════════════════════════════════════════════════════════════════
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
    if(btn.dataset.tab==='apartments') updateAllAptStatuses();
  });
});

// ═══ ADMIN LOGIN ══════════════════════════════════════════════════════════
async function doAdminLogin(){
  const pass=document.getElementById('admin-pass-input').value.trim();
  if(!pass) return;
  const btn=document.getElementById('admin-login-btn');
  btn.disabled=true;btn.textContent='...';
  try{
    const r=await fetch('/api/admin/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pass})});
    const d=await r.json();
    if(d.success){
      adminPassword=pass;
      document.getElementById('admin-login-overlay').style.display='none';
      document.getElementById('admin-panel').classList.add('visible');
      renderMatrix(activeYear);
      updateSummary();
      showToast('ברוך הבא!');
    } else {
      const el=document.getElementById('admin-login-error');
      el.style.display='block';el.textContent='סיסמה שגויה';
    }
  }catch(e){
    const el=document.getElementById('admin-login-error');
    el.style.display='block';el.textContent='שגיאת רשת';
  }finally{btn.disabled=false;btn.textContent='כניסה למערכת';}
}
document.getElementById('admin-login-btn').addEventListener('click',doAdminLogin);
document.getElementById('admin-pass-input').addEventListener('keydown',e=>{if(e.key==='Enter')doAdminLogin();});

// ═══ DEBT CALC (supports partial payments) ════════════════════════════════
function calcAptDebt(aptId){
  let debt=0;
  serverYears.forEach(year=>{
    const months=(year<currentYear)?12:(year===currentYear?currentMonth:0);
    for(let m=1;m<=months;m++){
      const paid=payments[aptId][`${year}-${m}`]||0;
      debt += Math.max(0, serverMonthlyFee - paid);
    }
  });
  return debt;
}

// ═══ MATRIX ════════════════════════════════════════════════════════════════
function cellState(aptId,key){
  const paid=payments[aptId][key]||0;
  if(paid<=0) return 'unpaid';
  if(paid>=serverMonthlyFee) return 'full';
  return 'partial';
}
function cellLabel(aptId,key){
  const state=cellState(aptId,key);
  const paid=payments[aptId][key]||0;
  if(state==='full')    return {icon:'✓',amount:''};
  if(state==='partial') return {icon:'~',amount:'₪'+paid};
  return {icon:'✗',amount:''};
}

function renderMatrix(year){
  activeYear=year;
  document.querySelectorAll('.year-tab').forEach(t=>t.classList.toggle('active',parseInt(t.dataset.year)===year));
  const tbody=document.getElementById('matrix-body');
  tbody.innerHTML='';
  const monthsToShow=(year<currentYear)?12:(year===currentYear?currentMonth:0);

  serverApartments.forEach(apt=>{
    const tr=document.createElement('tr');
    let html=`<td class="apt-th">דירה ${apt.id}<span class="apt-owner">${apt.ownerName||''}</span></td>`;
    for(let m=1;m<=12;m++){
      const key=`${year}-${m}`;
      if(m>monthsToShow){
        html+=`<td><div class="pay-cell future">—</div></td>`;
      } else {
        const state=cellState(apt.id,key);
        const lbl=cellLabel(apt.id,key);
        html+=`<td><div class="pay-cell ${state}" data-apt="${apt.id}" data-key="${key}" data-year="${year}" data-month="${m}">
          <span>${lbl.icon}</span>${lbl.amount?`<span class="cell-amount">${lbl.amount}</span>`:''}
        </div></td>`;
      }
    }
    const debt=calcAptDebt(apt.id);
    html+=`<td style="padding:6px;white-space:nowrap;">
      <span id="mtx-debt-${apt.id}" style="font-weight:700;font-size:0.82rem;color:${debt===0?'var(--green)':'var(--red)'};">
        ${debt===0?'✓ שולם':'₪'+debt.toLocaleString()}
      </span></td>`;
    tr.innerHTML=html;
    tbody.appendChild(tr);
  });

  // LEFT CLICK → toggle full/unpaid
  // RIGHT CLICK / LONG PRESS → partial amount popup
  tbody.querySelectorAll('.pay-cell[data-apt]').forEach(cell=>{
    let pressTimer=null;

    cell.addEventListener('click',e=>{
      const aptId=parseInt(cell.dataset.apt);
      const key=cell.dataset.key;
      const cur=payments[aptId][key]||0;
      // toggle: unpaid→full, partial→full, full→unpaid
      payments[aptId][key]=(cur>=serverMonthlyFee)?0:serverMonthlyFee;
      refreshCell(cell,aptId,key);
      updateDebtCell(aptId);
      updateSummary();
    });

    cell.addEventListener('contextmenu',e=>{
      e.preventDefault();
      openPartialPopup(cell);
    });

    // long press for mobile
    cell.addEventListener('touchstart',()=>{pressTimer=setTimeout(()=>openPartialPopup(cell),500);},{passive:true});
    cell.addEventListener('touchend',()=>{clearTimeout(pressTimer);});
    cell.addEventListener('touchmove',()=>{clearTimeout(pressTimer);});
  });
}

function refreshCell(cell,aptId,key){
  const state=cellState(aptId,key);
  const lbl=cellLabel(aptId,key);
  cell.className=`pay-cell ${state}`;
  cell.innerHTML=`<span>${lbl.icon}</span>${lbl.amount?`<span class="cell-amount">${lbl.amount}</span>`:''}`;
}

function updateDebtCell(aptId){
  const debt=calcAptDebt(aptId);
  const el=document.getElementById(`mtx-debt-${aptId}`);
  if(el){
    el.style.color=debt===0?'var(--green)':'var(--red)';
    el.textContent=debt===0?'✓ שולם':'₪'+debt.toLocaleString();
  }
  updateAptRowStatus(aptId);
}

// ═══ PARTIAL POPUP ════════════════════════════════════════════════════════
let popupCell=null;
function openPartialPopup(cell){
  popupCell=cell;
  const aptId=parseInt(cell.dataset.apt);
  const key=cell.dataset.key;
  const [year,month]=key.split('-');
  const MONTHS=['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
  document.getElementById('popup-title').textContent=`דירה ${aptId} — ${MONTHS[parseInt(month)-1]} ${year}`;
  document.getElementById('popup-amount').value=payments[aptId][key]||'';
  document.getElementById('popup-amount').placeholder=`מתוך ₪${serverMonthlyFee}`;

  const popup=document.getElementById('partial-popup');
  const rect=cell.getBoundingClientRect();
  const pw=220, ph=140;
  let top=rect.bottom+window.scrollY+6;
  let left=rect.right-pw;
  if(left<8) left=8;
  if(top+ph>window.scrollY+window.innerHeight) top=rect.top+window.scrollY-ph-6;
  popup.style.top=top+'px';
  popup.style.right='auto';
  popup.style.left=left+'px';
  popup.classList.add('show');
  document.getElementById('popup-overlay').style.display='block';
  setTimeout(()=>document.getElementById('popup-amount').focus(),50);
}

function closePopup(){
  document.getElementById('partial-popup').classList.remove('show');
  document.getElementById('popup-overlay').style.display='none';
  popupCell=null;
}

document.getElementById('popup-save').addEventListener('click',()=>{
  if(!popupCell) return;
  const aptId=parseInt(popupCell.dataset.apt);
  const key=popupCell.dataset.key;
  const val=parseInt(document.getElementById('popup-amount').value)||0;
  payments[aptId][key]=Math.min(val, serverMonthlyFee);
  refreshCell(popupCell,aptId,key);
  updateDebtCell(aptId);
  updateSummary();
  closePopup();
});

document.getElementById('popup-clear').addEventListener('click',()=>{
  if(!popupCell) return;
  const aptId=parseInt(popupCell.dataset.apt);
  payments[aptId][popupCell.dataset.key]=0;
  refreshCell(popupCell,aptId,popupCell.dataset.key);
  updateDebtCell(aptId);
  updateSummary();
  closePopup();
});

document.getElementById('popup-cancel').addEventListener('click',closePopup);
document.getElementById('popup-overlay').addEventListener('click',closePopup);
document.getElementById('popup-amount').addEventListener('keydown',e=>{
  if(e.key==='Enter') document.getElementById('popup-save').click();
  if(e.key==='Escape') closePopup();
});

// ═══ YEAR TABS ════════════════════════════════════════════════════════════
document.getElementById('year-tabs').addEventListener('click',e=>{
  const btn=e.target.closest('.year-tab');
  if(btn) renderMatrix(parseInt(btn.dataset.year));
});
document.getElementById('add-year-btn').addEventListener('click',async()=>{
  const maxY=Math.max(...serverYears);
  const newY=maxY+1;
  if(!confirm(`להוסיף שנת ${newY}?`)) return;
  try{
    const r=await fetch('/api/admin/add-year',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,year:newY})});
    const d=await r.json();
    if(d.success){
      serverYears.push(newY);serverYears.sort((a,b)=>a-b);
      const btn=document.createElement('button');
      btn.className='year-tab';btn.dataset.year=newY;btn.textContent=newY;
      document.getElementById('year-tabs').insertBefore(btn,document.getElementById('add-year-btn'));
      renderMatrix(newY);
      showToast(`שנת ${newY} נוספה!`);
    }
  }catch(e){showToast('שגיאה','error');}
});

// ═══ SUMMARY ══════════════════════════════════════════════════════════════
function updateSummary(){
  let clean=0,owed=0,total=0,collected=0;
  serverApartments.forEach(a=>{
    const d=calcAptDebt(a.id);
    if(d===0) clean++; else {owed++;total+=d;}
    // collected = sum of all paid amounts
    Object.values(payments[a.id]).forEach(v=>{ collected+=v||0; });
  });
  document.getElementById('sum-clean').textContent=clean;
  document.getElementById('sum-owed').textContent=owed;
  document.getElementById('sum-total').textContent='₪'+total.toLocaleString();
  document.getElementById('sum-collected').textContent='₪'+collected.toLocaleString();
}

// ═══ APT STATUS BADGE ═════════════════════════════════════════════════════
function updateAptRowStatus(aptId){
  const el=document.getElementById(`row-status-${aptId}`);
  if(!el) return;
  const d=calcAptDebt(aptId);
  el.className='badge '+(d===0?'badge-green':'badge-red');
  el.textContent=d===0?'שולם':'₪'+d.toLocaleString();
}
function updateAllAptStatuses(){serverApartments.forEach(a=>updateAptRowStatus(a.id));}

// show/hide password
document.getElementById('apt-rows')?document.getElementById('apt-rows'):document;
document.addEventListener('click',e=>{
  const btn=e.target.closest('.show-pass-btn');
  if(!btn) return;
  const id=btn.dataset.id;
  const el=document.getElementById(`cur-pass-${id}`);
  if(el.textContent==='•••'){el.textContent=btn.dataset.pass;btn.textContent='הסתר';}
  else{el.textContent='•••';btn.textContent='הצג';}
});

// ═══ SPECIAL CHARGES ══════════════════════════════════════════════════════
document.getElementById('sc-list').addEventListener('click',e=>{
  const chip=e.target.closest('.sc-chip');
  if(chip){
    chip.classList.toggle('paid');
    chip.textContent=chip.classList.contains('paid')?`✓ דירה ${chip.dataset.apt}`:`○ דירה ${chip.dataset.apt}`;
    return;
  }
  const del=e.target.closest('.delete-sc-btn');
  if(del){
    const card=del.closest('.sc-card');
    if(!confirm('למחוק גבייה זו?')) return;
    fetch(`/api/admin/special/${card.dataset.scId}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword})})
      .then(r=>r.json()).then(d=>{if(d.success){card.remove();showToast('נמחק');}});
  }
});

document.getElementById('add-sc-btn').addEventListener('click',async()=>{
  const name=document.getElementById('sc-name').value.trim();
  const desc=document.getElementById('sc-desc').value.trim();
  const cost=document.getElementById('sc-cost').value;
  const date=document.getElementById('sc-date').value;
  if(!name){showToast('הזן שם לגבייה','error');return;}
  try{
    const r=await fetch('/api/admin/add-special',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,name,description:desc,costPerApartment:cost,date})});
    const d=await r.json();
    if(d.success){
      ['sc-name','sc-desc','sc-cost'].forEach(id=>{document.getElementById(id).value='';});
      document.getElementById('sc-date').value='';
      addScCard(d.charge);showToast('גבייה נוספה!');
    }
  }catch(e){showToast('שגיאה','error');}
});

function addScCard(sc){
  let chips='';
  for(let i=1;i<=20;i++) chips+=`<div class="sc-chip" data-apt="${i}">○ דירה ${i}</div>`;
  const div=document.createElement('div');
  div.className='sc-card';div.id=`sc-card-${sc.id}`;div.dataset.scId=sc.id;
  div.innerHTML=`
    <div class="sc-hdr">
      <input type="text"   class="sc-name" value="${sc.name}" placeholder="שם" style="flex:2;min-width:130px;">
      <input type="text"   class="sc-desc" value="${sc.description||''}" placeholder="תיאור" style="flex:2;min-width:130px;">
      <input type="number" class="sc-cost" value="${sc.costPerApartment}" min="0" style="width:100px;">
      <input type="date"   class="sc-date" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;padding:7px 10px;width:140px;">
      <button class="btn btn-danger btn-sm delete-sc-btn">🗑</button>
    </div>
    <div class="text-muted text-small" style="margin-bottom:8px;">לחץ על דירה לסימון תשלום:</div>
    <div class="sc-chips">${chips}</div>`;
  document.getElementById('sc-list').appendChild(div);
}

// ═══ SAVE ALL ══════════════════════════════════════════════════════════════
async function saveAll(){
  const btn=document.getElementById('save-all-btn');
  btn.disabled=true;btn.textContent='...שומר';

  const np1=document.getElementById('set-new-admin-pass').value;
  const np2=document.getElementById('set-new-admin-pass2').value;
  if(np1||np2){
    if(np1!==np2){showToast('הסיסמאות אינן תואמות','error');btn.disabled=false;btn.textContent='💾 שמור הכל';return;}
    if(np1.length<4){showToast('סיסמה קצרה מדי','error');btn.disabled=false;btn.textContent='💾 שמור הכל';return;}
  }

  const apartments=[];
  document.querySelectorAll('.apt-grid[data-apt-id]').forEach(row=>{
    const id=parseInt(row.dataset.aptId);
    const passVal=row.querySelector('.pass-input').value;
    apartments.push({
      id,
      ownerName: row.querySelector('.owner-input').value||'',
      note:      row.querySelector('.note-input')?row.querySelector('.note-input').value||'':'',
      password:  passVal&&passVal.length>=4?passVal:'',
      payments:  payments[id]||{}
    });
  });

  const specialCharges=[];
  document.querySelectorAll('#sc-list .sc-card').forEach(card=>{
    const paid=[];
    for(let i=1;i<=20;i++){
      const chip=card.querySelector(`.sc-chip[data-apt="${i}"]`);
      paid.push({id:i,paid:chip?chip.classList.contains('paid'):false});
    }
    specialCharges.push({
      id:               card.dataset.scId,
      name:             card.querySelector('.sc-name').value||'',
      description:      card.querySelector('.sc-desc').value||'',
      costPerApartment: parseInt(card.querySelector('.sc-cost').value)||0,
      date:             card.querySelector('.sc-date').value||'',
      apartments:       paid
    });
  });

  const settings={
    buildingName:    document.getElementById('set-bname').value,
    buildingAddress: document.getElementById('set-baddress').value,
    monthlyFee:      document.getElementById('set-fee').value,
    bankDetails:{
      bank:        document.getElementById('set-bank').value,
      branch:      document.getElementById('set-branch').value,
      account:     document.getElementById('set-account').value,
      beneficiary: document.getElementById('set-beneficiary').value
    },
    payboxLink: document.getElementById('set-paybox').value,
    years: serverYears
  };
  if(np1) settings.newAdminPassword=np1;

  try{
    const r=await fetch('/api/admin/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,apartments,specialCharges,settings})});
    const d=await r.json();
    if(d.success){
      if(np1) adminPassword=np1;
      showToast('✓ '+d.message);
      document.getElementById('set-new-admin-pass').value='';
      document.getElementById('set-new-admin-pass2').value='';
      document.querySelectorAll('.pass-input').forEach(i=>i.value='');
      updateAllAptStatuses();updateSummary();
    } else showToast(d.message||'שגיאה','error');
  }catch(e){showToast('שגיאת רשת','error');}
  finally{btn.disabled=false;btn.textContent='💾 שמור הכל';}
}

document.getElementById('save-all-btn').addEventListener('click',saveAll);
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key==='s'){
    e.preventDefault();
    if(document.getElementById('admin-panel').classList.contains('visible')) saveAll();
  }
});
</script>
</body>
