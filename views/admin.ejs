// ═══════════════════════════════════════════════════════════════
//  SERVICES
// ═══════════════════════════════════════════════════════════════
function renderServices() {
  const services = appData.serviceTransactions;
  if (!services.length) {
    document.getElementById('servicesContent').innerHTML = '<div class="empty-state"><div class="empty-icon">🔧</div><p>אין עסקאות שירות</p></div>';
    return;
  }
  let html = '';
  services.forEach(s => {
    const prof = appData.settings.professions.find(p => p.id === s.professionId);
    const status = appData.settings.workStatuses.find(st => st.id === s.statusId);
    const paid = (s.payments || []).reduce((sum, p) => sum + Number(p.amount), 0);
    const remaining = Number(s.totalCost) - paid;
    const pct = s.totalCost > 0 ? Math.round((paid / Number(s.totalCost)) * 100) : 0;

    html += `<div class="card mb-2">
      <div class="card-header">
        <div>
          <div class="card-title">${s.name}</div>
          <div class="text-sm text-muted">${prof ? prof.name : '-'} ${s.phone ? '| ' + s.phone : ''}</div>
        </div>
        <div class="flex gap-1 flex-wrap">
          ${s.isRetainer ? '<span class="badge badge-gold">ריטיינר</span>' : ''}
          <span class="badge ${s.statusId === 'done' ? 'badge-success' : s.statusId === 'inprogress' ? 'badge-warning' : 'badge-neutral'}">${status ? status.name : '-'}</span>
          <button class="btn-icon" onclick="openServiceModal('${s.id}')">✏️</button>
          <button class="btn-icon" onclick="deleteService('${s.id}')">🗑️</button>
        </div>
      </div>
      <div class="grid grid-3 mb-2" style="grid-template-columns:repeat(auto-fit,minmax(120px,1fr))">
        <div><div class="stat-label">עלות כוללת</div><div class="text-bold">₪${Number(s.totalCost).toLocaleString()}</div></div>
        <div><div class="stat-label">שולם</div><div class="text-success text-bold">₪${paid.toLocaleString()}</div></div>
        <div><div class="stat-label">יתרה לספק</div><div class="${remaining > 0 ? 'text-danger' : 'text-success'} text-bold">₪${Math.abs(remaining).toLocaleString()}</div></div>
      </div>
      <div class="progress-wrap mb-2"><div class="progress-bar ${pct < 50 ? 'warning' : ''}" style="width:${pct}%"></div></div>
      <button class="btn btn-sm btn-secondary" onclick="addServicePayment('${s.id}')">+ הוסף תשלום לספק</button>
      ${s.payments && s.payments.length ? `<div class="mt-2 text-sm text-muted">תשלומים: ${s.payments.map(p=>`₪${p.amount} (${p.date||''})`).join(', ')}</div>` : ''}
    </div>`;
  });
  document.getElementById('servicesContent').innerHTML = html;
}

function openServiceModal(id) {
  editingId = id || null;
  document.getElementById('serviceModalTitle').textContent = id ? 'עריכת עסקת שירות' : 'עסקת שירות חדשה';

  const profSel = document.getElementById('svProfession');
  profSel.innerHTML = appData.settings.professions.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
  const statSel = document.getElementById('svStatus');
  statSel.innerHTML = appData.settings.workStatuses.map(s => `<option value="${s.id}">${s.name}</option>`).join('');

  if (id) {
    const s = appData.serviceTransactions.find(x => x.id === id);
    document.getElementById('svName').value = s.name;
    document.getElementById('svProfession').value = s.professionId;
    document.getElementById('svStatus').value = s.statusId;
    document.getElementById('svPhone').value = s.phone || '';
    document.getElementById('svTotalCost').value = s.totalCost;
    document.getElementById('svIsRetainer').checked = s.isRetainer;
    document.getElementById('svNote').value = s.note || '';
  } else {
    ['svName','svPhone','svNote'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('svTotalCost').value = '';
    document.getElementById('svIsRetainer').checked = false;
  }
  openModal('serviceModal');
}

