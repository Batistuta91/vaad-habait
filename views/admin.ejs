<!-- inline partial editing — no popup needed -->

<div class="toast" id="toast"></div>

<script>
const MONTHS_HE = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
let adminPassword = '';
let currentYear   = <%=currentYear%>;
let currentMonth  = <%=currentMonth%>;
let activeYear    = <%=currentYear%>;
const serverApartments = <%-JSON.stringify(apartments)%>;
const serverYears      = <%-JSON.stringify(years)%>;
let serverMonthlyFee   = <%=monthlyFee%>;

// transactions in memory
let txList = <%-JSON.stringify(transactions||[])%>;

let payments = {};
serverApartments.forEach(a=>{
  payments[a.id]={};
  Object.keys(a.payments||{}).forEach(k=>{
    const v=a.payments[k];
    payments[a.id][k]=typeof v==='boolean'?(v?serverMonthlyFee:0):(Number(v)||0);
  });
});

// THEME
function applyTheme(mode){
  document.body.classList.toggle('light',mode==='light');
  document.documentElement.classList.toggle('pre-light', mode==='light');
  const i=document.getElementById('theme-icon'),l=document.getElementById('theme-label');
  if(i) i.textContent=mode==='light'?'☀️':'🌙';
  if(l) l.textContent=mode==='light'?'בהיר':'כהה';
  localStorage.setItem('vaad_theme',mode);
}
applyTheme(localStorage.getItem('vaad_theme')||'light');
document.getElementById('theme-toggle-btn').addEventListener('click',()=>{
  applyTheme(document.body.classList.contains('light')?'dark':'light');
});

// TOAST
function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg;t.className=`toast show ${type}`;
  setTimeout(()=>{t.className='toast';},3200);
}

// TABS
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
    if(btn.dataset.tab==='apartments') updateAllAptStatuses();
  });
});

// LOGIN
async function doAdminLogin(){
  const pass=document.getElementById('admin-pass-input').value.trim();
  if(!pass) return;
  const btn=document.getElementById('admin-login-btn');
  btn.disabled=true;btn.textContent='...';
  try{
    const r=await fetch('/api/admin/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pass})});
    const d=await r.json();
    if(d.success){
      adminPassword=pass;
      document.getElementById('admin-login-overlay').style.display='none';
      document.getElementById('admin-panel').classList.add('visible');
      renderMatrix(activeYear);
      updateSummary();
      calcFinSummary();
      showToast('ברוך הבא!');
    } else {
      const el=document.getElementById('admin-login-error');
      el.style.display='block';el.textContent='סיסמה שגויה';
    }
  }catch(e){
    document.getElementById('admin-login-error').style.display='block';
    document.getElementById('admin-login-error').textContent='שגיאת רשת';
  }finally{btn.disabled=false;btn.textContent='כניסה למערכת';}
}
document.getElementById('admin-login-btn').addEventListener('click',doAdminLogin);
document.getElementById('admin-pass-input').addEventListener('keydown',e=>{if(e.key==='Enter')doAdminLogin();});

// Auto-login if coming from main login page
(function(){
  const stored = sessionStorage.getItem('vaad_admin_pass');
  if(stored){
    sessionStorage.removeItem('vaad_admin_pass');
    document.getElementById('admin-pass-input').value = stored;
    doAdminLogin();
  }
})();

// CALC DEBT
function calcAptDebt(aptId){
  let debt=0;
  serverYears.forEach(year=>{
    const months=year<currentYear?12:year===currentYear?currentMonth:0;
    for(let m=1;m<=months;m++){
      const paid=payments[aptId][`${year}-${m}`]||0;
      debt+=Math.max(0,serverMonthlyFee-paid);
    }
  });
  return debt;
}

// MATRIX
function cellState(aptId,key){
  const p=payments[aptId][key]||0;
  return p<=0?'unpaid':p>=serverMonthlyFee?'full':'partial';
}

function renderMatrix(year){
  activeYear=year;
  document.querySelectorAll('.year-tab').forEach(t=>t.classList.toggle('active',parseInt(t.dataset.year)===year));
  const tbody=document.getElementById('matrix-body');
  tbody.innerHTML='';
  const monthsToShow=year<currentYear?12:year===currentYear?currentMonth:0;

  serverApartments.forEach(apt=>{
    const tr=document.createElement('tr');
    let html=`<td class="apt-th">דירה ${apt.id}<span class="apt-owner">${apt.ownerName||''}</span></td>`;
    for(let m=1;m<=12;m++){
      const key=`${year}-${m}`;
      if(m>monthsToShow){
        html+=`<td><div class="pay-cell future">—</div></td>`;
      } else {
        const state=cellState(apt.id,key);
        const paid=payments[apt.id][key]||0;
        const icon=state==='full'?'✓':state==='unpaid'?'✗':'';
        const amtLine=state==='partial'?`<span class="cell-amount" style="font-size:0.72rem;font-weight:700;">₪${paid}</span>`:'';
        html+=`<td><div class="pay-cell ${state}" data-apt="${apt.id}" data-key="${key}" data-year="${year}" data-month="${m}">
          ${icon?`<span>${icon}</span>`:''}${amtLine}
          <button class="partial-btn" title="תשלום חלקי">✏</button>
        </div></td>`;
      }
    }
    const debt=calcAptDebt(apt.id);
    html+=`<td style="padding:6px;white-space:nowrap;">
      <span id="mtx-debt-${apt.id}" style="font-weight:700;font-size:0.8rem;color:${debt===0?'var(--green)':'var(--red)'};">
        ${debt===0?'✓':'₪'+debt.toLocaleString()}</span></td>`;
    // mark-all button
    const allPaid=checkAllPaidForYear(apt.id,year,monthsToShow);
    html+=`<td style="padding:4px 6px;text-align:center;">
      <button class="mark-all-btn" data-apt="${apt.id}" data-year="${year}" data-months="${monthsToShow}" data-state="${allPaid?'full':'unpaid'}">
        ${allPaid?'✗ בטל הכל':'✓ שולם הכל'}
      </button></td>`;
    tr.innerHTML=html;
    tbody.appendChild(tr);
  });

  // left click = toggle full/unpaid; ✏ button = inline editor
  tbody.querySelectorAll('.pay-cell[data-apt]').forEach(cell=>{
    let pressTimer=null;

    cell.addEventListener('click', e=>{
      if (activeInlineCell) return; // editor open — ignore
      // ✏ button opens inline editor
      if(e.target.closest('.partial-btn')){
        e.stopPropagation();
        openInlineEditor(cell);
        return;
      }
      const aptId=parseInt(cell.dataset.apt),key=cell.dataset.key;
      const cur=payments[aptId][key]||0;
      payments[aptId][key]=cur>=serverMonthlyFee?0:serverMonthlyFee;
      refreshCell(cell,aptId,key);
      updateDebtCell(aptId);updateSummary();
      refreshMarkAllBtn(cell.closest('tr'),aptId,parseInt(cell.dataset.year),monthsToShow);
    });

    // long press mobile → inline editor
    cell.addEventListener('touchstart',()=>{
      pressTimer=setTimeout(()=>openInlineEditor(cell),500);
    },{passive:true});
    cell.addEventListener('touchend', ()=>clearTimeout(pressTimer));
    cell.addEventListener('touchmove',()=>clearTimeout(pressTimer));
  });

  // mark-all buttons
  tbody.querySelectorAll('.mark-all-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const aptId=parseInt(btn.dataset.apt);
      const yr=parseInt(btn.dataset.year);
      const months=parseInt(btn.dataset.months);
      const isFull=btn.dataset.state==='full';
      for(let m=1;m<=months;m++){
        payments[aptId][`${yr}-${m}`]=isFull?0:serverMonthlyFee;
      }
      renderMatrix(yr); // re-render to refresh all cells
      updateSummary();
    });
  });
}

function checkAllPaidForYear(aptId,year,months){
  for(let m=1;m<=months;m++){
    if((payments[aptId][`${year}-${m}`]||0)<serverMonthlyFee) return false;
  }
  return months>0;
}

function refreshMarkAllBtn(tr,aptId,year,months){
  const btn=tr.querySelector('.mark-all-btn');
  if(!btn) return;
  const allPaid=checkAllPaidForYear(aptId,year,months);
  btn.dataset.state=allPaid?'full':'unpaid';
  btn.textContent=allPaid?'✗ בטל הכל':'✓ שולם הכל';
}

function refreshCell(cell,aptId,key){
  const state=cellState(aptId,key);
  const paid=payments[aptId][key]||0;
  const icon=state==='full'?'✓':state==='unpaid'?'✗':'';
  const amtLine=state==='partial'?`<span class="cell-amount" style="font-size:0.72rem;font-weight:700;">₪${paid}</span>`:'';
  cell.className=`pay-cell ${state}`;
  cell.innerHTML=`${icon?`<span>${icon}</span>`:''}${amtLine}<button class="partial-btn" title="תשלום חלקי">✏</button>`;
}

function updateDebtCell(aptId){
  const debt=calcAptDebt(aptId);
  const el=document.getElementById(`mtx-debt-${aptId}`);
  if(el){el.style.color=debt===0?'var(--green)':'var(--red)';el.textContent=debt===0?'✓':'₪'+debt.toLocaleString();}
  updateAptRowStatus(aptId);
}

// YEAR TABS
document.getElementById('year-tabs').addEventListener('click',e=>{
  const btn=e.target.closest('.year-tab');
  if(btn) renderMatrix(parseInt(btn.dataset.year));
});
document.getElementById('add-year-btn').addEventListener('click',async()=>{
  const maxY=Math.max(...serverYears);const newY=maxY+1;
  if(!confirm(`להוסיף שנת ${newY}?`)) return;
  try{
    const r=await fetch('/api/admin/add-year',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,year:newY})});
    const d=await r.json();
    if(d.success){
      serverYears.push(newY);serverYears.sort((a,b)=>a-b);
      const btn=document.createElement('button');btn.className='year-tab';btn.dataset.year=newY;btn.textContent=newY;
      document.getElementById('year-tabs').insertBefore(btn,document.getElementById('add-year-btn'));
      renderMatrix(newY);showToast(`שנת ${newY} נוספה!`);
    }
  }catch(e){showToast('שגיאה','error');}
});

// SUMMARY
function updateSummary(){
  let clean=0,owed=0,total=0;
  serverApartments.forEach(a=>{
    const d=calcAptDebt(a.id);
    if(d===0) clean++; else{owed++;total+=d;}
  });
  document.getElementById('sum-clean').textContent=clean;
  document.getElementById('sum-owed').textContent=owed;
  document.getElementById('sum-total').textContent='₪'+total.toLocaleString();
}

function updateAptRowStatus(aptId){
  const el=document.getElementById(`row-status-${aptId}`);
  if(!el) return;
  const d=calcAptDebt(aptId);
  el.className='badge '+(d===0?'badge-green':'badge-red');
  el.textContent=d===0?'שולם':'₪'+d.toLocaleString();
}
function updateAllAptStatuses(){serverApartments.forEach(a=>updateAptRowStatus(a.id));}

