<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ממשק מנהל — <%= buildingName %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .tabs{display:flex;gap:4px;margin-bottom:24px;flex-wrap:wrap;}
    .tab-btn{padding:9px 18px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg2);color:var(--text-muted);font-family:'Heebo',sans-serif;font-size:0.88rem;font-weight:600;cursor:pointer;transition:var(--transition);}
    .tab-btn.active{background:var(--gold);color:#111;border-color:var(--gold);}
    .tab-pane{display:none;} .tab-pane.active{display:block;}

    /* apt table */
    .apt-row{display:grid;grid-template-columns:42px 1fr 1fr 110px 110px 1fr 120px;gap:8px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--border);font-size:0.86rem;}
    .apt-row:hover{background:rgba(255,255,255,0.02);}
    .apt-row.header{background:var(--bg);color:var(--text-muted);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:10px 14px;border-radius:var(--radius-sm) var(--radius-sm) 0 0;}
    .apt-row input[type=text],.apt-row input[type=password],.apt-row input[type=number]{background:var(--bg2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.85rem;padding:7px 10px;width:100%;direction:rtl;transition:var(--transition);}
    .apt-row input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 2px var(--gold-dim);}
    @media(max-width:900px){
      .apt-row{grid-template-columns:36px 1fr 1fr;gap:6px;}
      .apt-row .col-pass,.apt-row .col-note,.apt-row .col-status{display:none;}
      .apt-row.header .col-pass,.apt-row.header .col-note,.apt-row.header .col-status{display:none;}
    }
    @media(max-width:600px){
      .apt-row{grid-template-columns:32px 1fr;}
      .apt-row .col-owner,.apt-row .col-pw-disp{display:none;}
      .apt-row.header .col-owner,.apt-row.header .col-pw-disp{display:none;}
    }

    /* monthly payment matrix */
    .matrix-wrapper{overflow-x:auto;}
    .matrix-table{border-collapse:collapse;width:100%;font-size:0.8rem;}
    .matrix-table th{background:var(--bg);color:var(--text-muted);padding:8px 6px;text-align:center;border:1px solid var(--border);white-space:nowrap;font-size:0.72rem;}
    .matrix-table td{border:1px solid var(--border);padding:0;text-align:center;}
    .matrix-table .apt-th{text-align:right;padding:8px 10px;white-space:nowrap;font-weight:600;min-width:80px;}
    .pay-cell{width:100%;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background 0.15s;user-select:none;font-size:0.88rem;}
    .pay-cell.paid{background:rgba(34,197,94,0.18);color:var(--green);}
    .pay-cell.unpaid{background:rgba(239,68,68,0.08);color:var(--text-dim);}
    .pay-cell:hover{opacity:0.75;}
    .year-tab-row{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap;}
    .year-tab{padding:6px 16px;border-radius:50px;border:1px solid var(--border);background:var(--bg2);color:var(--text-muted);font-size:0.85rem;font-weight:600;cursor:pointer;transition:var(--transition);}
    .year-tab.active{background:var(--blue);color:#fff;border-color:var(--blue);}

    /* special charges admin */
    .sc-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:14px;}
    .sc-header{display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;margin-bottom:12px;}
    .sc-header input{background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.9rem;padding:8px 11px;direction:rtl;transition:var(--transition);}
    .sc-header input:focus{outline:none;border-color:var(--blue);}
    .sc-header .sc-name{flex:2;min-width:130px;}
    .sc-header .sc-desc{flex:2;min-width:130px;}
    .sc-header .sc-cost{width:110px;}
    .sc-header .sc-date{width:130px;}
    .sc-chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px;}
    .sc-chip{display:flex;align-items:center;gap:4px;padding:5px 11px;border-radius:50px;font-size:0.8rem;font-weight:600;cursor:pointer;user-select:none;transition:var(--transition);border:1px solid var(--border);background:var(--bg3);color:var(--text-muted);}
    .sc-chip.paid{background:var(--green-dim);color:var(--green);border-color:rgba(34,197,94,0.35);}
    .sc-chip:hover{opacity:0.8;}

    /* settings */
    .settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    @media(max-width:600px){.settings-grid{grid-template-columns:1fr;}}
    .settings-grid .form-group input{width:100%;background:var(--bg2);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.9rem;padding:10px 12px;transition:var(--transition);}
    .settings-grid .form-group input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 2px var(--gold-dim);}

    /* summary */
    .summary-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:24px;}
    .sum-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px;text-align:center;}
    .sum-val{font-size:1.6rem;font-weight:900;font-family:'Frank Ruhl Libre',serif;}
    .sum-lbl{font-size:0.75rem;color:var(--text-muted);margin-top:2px;}

    .add-row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;background:var(--bg2);border:1px dashed var(--border-strong);border-radius:var(--radius);padding:18px;margin-bottom:18px;}
    .add-row .form-group{flex:1;min-width:120px;}
    .add-row .form-group input{width:100%;background:var(--bg);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:'Heebo',sans-serif;font-size:0.9rem;padding:9px 12px;direction:rtl;}
    .add-row .form-group input:focus{outline:none;border-color:var(--gold);}

    .info-badge{display:inline-flex;align-items:center;gap:6px;background:var(--blue-dim);border:1px solid rgba(99,102,241,0.3);color:var(--blue);border-radius:var(--radius-sm);padding:10px 16px;font-size:0.85rem;font-weight:600;margin-bottom:18px;}
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🔐</div>
      <div class="logo-text">ממשק מנהל <span><%= buildingName %></span></div>
    </div>
    <nav class="header-nav"><a href="/">← לממשק דיירים</a></nav>
  </div>
</header>

<!-- ══ ADMIN LOGIN ═══════════════════════════════════════════════════════ -->
<div id="admin-login-overlay" class="admin-login-overlay">
  <div class="admin-login-box">
    <span class="lock-icon">🔐</span>
    <h2>כניסת ועד בית</h2>
    <p>אזור מוגן — הזן סיסמת מנהל</p>
    <p style="font-size:0.8rem;color:var(--gold);margin-bottom:16px;">סיסמת ברירת מחדל: <strong>vaad2024</strong></p>
    <div class="form-group" style="text-align:right;">
      <label>סיסמת מנהל</label>
      <input type="password" id="admin-pass-input" placeholder="הזן סיסמה" style="width:100%;background:var(--bg);border:1px solid var(--border-strong);border-radius:8px;color:var(--text);font-family:Heebo,sans-serif;font-size:1rem;padding:12px 14px;">
    </div>
    <div id="admin-login-error" style="color:var(--red);font-size:0.85rem;margin:10px 0;display:none;"></div>
    <button class="btn btn-primary btn-full mt-12" id="admin-login-btn">כניסה למערכת</button>
  </div>
</div>

<!-- ══ ADMIN PANEL ════════════════════════════════════════════════════════ -->
<div id="admin-panel">
  <div class="page-hero">
    <h1>ניהול <span>ועד הבית</span></h1>
    <p>שליטה מלאה על כל הנתונים</p>
  </div>

  <div class="container">

    <!-- summary -->
    <div class="summary-cards" id="summary-cards">
      <div class="sum-card"><div class="sum-val" id="sum-clean" style="color:var(--green);">—</div><div class="sum-lbl">דירות ללא חוב</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-owed" style="color:var(--red);">—</div><div class="sum-lbl">דירות עם חוב</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-total" style="color:var(--gold);">—</div><div class="sum-lbl">חוב כולל (₪)</div></div>
      <div class="sum-card"><div class="sum-val" id="sum-monthly" style="color:var(--blue);">—</div><div class="sum-lbl">ועד חודשי (₪)</div></div>
    </div>

    <div class="tabs">
      <button class="tab-btn active" data-tab="payments">📅 תשלומים חודשיים</button>
      <button class="tab-btn" data-tab="apartments">🏠 דירות ופרטים</button>
      <button class="tab-btn" data-tab="special">⚡ גביות מיוחדות</button>
      <button class="tab-btn" data-tab="settings">⚙️ הגדרות</button>
    </div>

    <!-- ── TAB: PAYMENTS ──────────────────────────────────────────────── -->
    <div class="tab-pane active" id="tab-payments">
      <div class="info-badge">💡 לחץ על תא כדי לסמן / לבטל תשלום. השינויים נשמרים בלחיצת "שמור הכל".</div>

      <div class="year-tab-row" id="year-tabs">
        <% years.forEach(y => { %>
        <button class="year-tab <%= y===currentYear?'active':'' %>" data-year="<%= y %>"><%= y %></button>
        <% }) %>
        <button class="btn btn-outline btn-sm" id="add-year-btn">+ הוסף שנה</button>
      </div>

      <div class="card" style="padding:0;">
        <div class="matrix-wrapper">
          <table class="matrix-table" id="payments-matrix">
            <thead>
              <tr>
                <th class="apt-th">דירה</th>
                <% for(let m=1;m<=12;m++){ %>
                <th><%= ['ינו','פבר','מרץ','אפר','מאי','יוני','יולי','אוג','ספט','אוק','נוב','דצמ'][m-1] %></th>
                <% } %>
                <th>סה"כ חוב</th>
              </tr>
            </thead>
            <tbody id="matrix-body">
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── TAB: APARTMENTS ───────────────────────────────────────────── -->
    <div class="tab-pane" id="tab-apartments">
      <div class="card" style="padding:0;">
        <div class="apt-row header">
          <div>#</div>
          <div>שם בעל הדירה</div>
          <div class="col-owner">סיסמה חדשה</div>
          <div class="col-pass">סיסמה נוכחית</div>
          <div class="col-pw-disp">הצג</div>
          <div class="col-note col-status">הערה לדייר</div>
          <div class="col-status">סטטוס</div>
        </div>
        <div id="apt-rows">
          <% apartments.forEach(apt => { %>
          <div class="apt-row" data-apt-id="<%= apt.id %>">
            <div><span class="apt-id-tag"><%= apt.id %></span></div>
            <div><input type="text" class="owner-input" value="<%= apt.ownerName||'' %>" placeholder="שם בעל הדירה"></div>
            <div class="col-owner"><input type="text" class="pass-input" value="" placeholder="סיסמה חדשה (4+ תווים)"></div>
            <div class="col-pass" style="font-size:0.78rem;color:var(--text-dim);" id="cur-pass-<%= apt.id %>">•••</div>
            <div class="col-pw-disp">
              <button class="btn btn-ghost btn-sm show-pass-btn" data-pass="<%= apt.password %>" style="font-size:0.75rem;">הצג</button>
            </div>
            <div class="col-note"><input type="text" class="note-input" value="<%= apt.note||'' %>" placeholder="הערה לדייר..."></div>
            <div class="col-status"><span class="badge" id="row-status-<%= apt.id %>">—</span></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ── TAB: SPECIAL CHARGES ──────────────────────────────────────── -->
    <div class="tab-pane" id="tab-special">
      <div class="add-row">
        <div class="form-group"><label>שם הגבייה</label><input type="text" id="sc-name" placeholder="פיצוץ צינור, תיקון מעלית..."></div>
        <div class="form-group"><label>תיאור</label><input type="text" id="sc-desc" placeholder="תיאור קצר"></div>
        <div class="form-group" style="max-width:130px;"><label>עלות לדירה (₪)</label><input type="number" id="sc-cost" placeholder="0" min="0"></div>
        <div class="form-group" style="max-width:150px;"><label>תאריך</label><input type="date" id="sc-date" style="background:var(--bg);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-size:0.9rem;padding:9px 12px;"></div>
        <div class="form-group" style="flex:none;"><label style="visibility:hidden;">add</label><button class="btn btn-green" id="add-sc-btn">+ הוסף</button></div>
      </div>
      <div id="sc-list">
        <% specialCharges.forEach(sc => { %>
        <div class="sc-card" id="sc-card-<%= sc.id %>" data-sc-id="<%= sc.id %>">
          <div class="sc-header">
            <input type="text" class="sc-name" value="<%= sc.name %>" placeholder="שם">
            <input type="text" class="sc-desc" value="<%= sc.description||'' %>" placeholder="תיאור">
            <input type="number" class="sc-cost" value="<%= sc.costPerApartment %>" min="0">
            <input type="date" class="sc-date" value="<%= sc.date||'' %>" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;padding:7px 10px;">
            <button class="btn btn-danger btn-sm delete-sc-btn">🗑</button>
          </div>
          <div class="text-muted text-small">לחץ על דירה לסימון תשלום:</div>
          <div class="sc-chips">
            <% for(let i=1;i<=20;i++){
              const entry=sc.apartments.find(a=>a.id===i);
              const isPaid=entry&&entry.paid; %>
            <div class="sc-chip <%= isPaid?'paid':'' %>" data-apt="<%= i %>"><%= isPaid?'✓':'○' %> דירה <%= i %></div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- ── TAB: SETTINGS ─────────────────────────────────────────────── -->
    <div class="tab-pane" id="tab-settings">

      <div class="card" style="margin-bottom:16px;">
        <h3 class="section-title" style="margin-bottom:20px;">פרטי הבניין</h3>
        <div class="settings-grid">
          <div class="form-group"><label>שם הבניין</label><input type="text" id="set-bname" value="<%= buildingName %>"></div>
          <div class="form-group"><label>כתובת הבניין</label><input type="text" id="set-baddress" value="<%= buildingAddress %>"></div>
          <div class="form-group"><label>ועד חודשי (₪)</label><input type="number" id="set-fee" value="<%= monthlyFee %>"></div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <h3 class="section-title" style="margin-bottom:20px;">פרטי בנק ו-PayBox</h3>
        <div class="settings-grid">
          <div class="form-group"><label>שם הבנק</label><input type="text" id="set-bank" value="<%= bankDetails.bank %>"></div>
          <div class="form-group"><label>סניף</label><input type="text" id="set-branch" value="<%= bankDetails.branch %>"></div>
          <div class="form-group"><label>מספר חשבון</label><input type="text" id="set-account" value="<%= bankDetails.account %>"></div>
          <div class="form-group"><label>שם הנהנה</label><input type="text" id="set-beneficiary" value="<%= bankDetails.beneficiary %>"></div>
        </div>
        <div class="form-group mt-12"><label>קישור PayBox</label><input type="text" id="set-paybox" value="<%= payboxLink %>" style="width:100%;background:var(--bg2);border:1px solid var(--border-strong);border-radius:6px;color:var(--text);font-family:Heebo,sans-serif;font-size:0.9rem;padding:10px 12px;"></div>
      </div>

      <div class="card">
        <h3 class="section-title" style="margin-bottom:20px;">שינוי סיסמת מנהל</h3>
        <div class="settings-grid">
          <div class="form-group">
            <label>סיסמה חדשה למנהל (4+ תווים)</label>
            <input type="password" id="set-new-admin-pass" placeholder="השאר ריק כדי לא לשנות">
          </div>
          <div class="form-group">
            <label>אימות סיסמה חדשה</label>
            <input type="password" id="set-new-admin-pass2" placeholder="הזן שוב">
          </div>
        </div>
        <p class="text-muted mt-8" style="font-size:0.82rem;">⚠️ לאחר שינוי הסיסמה, תצטרך להתחבר מחדש.</p>
      </div>

    </div>

  </div><!-- /container -->

  <div class="save-bar">
    <span class="text-muted" style="align-self:center;font-size:0.85rem;">Ctrl+S לשמירה מהירה</span>
    <button class="btn btn-primary" id="save-all-btn">💾 שמור הכל</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ═══ STATE ════════════════════════════════════════════════════════════════
let adminPassword = '';
let currentYear   = <%= currentYear %>;
let currentMonth  = <%= currentMonth %>;
let activeYear    = <%= currentYear %>;

// Raw apartments from server (for payment matrix)
const serverApartments = <%- JSON.stringify(apartments) %>;
const serverYears      = <%- JSON.stringify(years) %>;
const serverMonthlyFee = <%= monthlyFee %>;

// Working copy of payments: { aptId: { "year-month": bool } }
let payments = {};
serverApartments.forEach(a => { payments[a.id] = Object.assign({}, a.payments||{}); });

// ═══ TOAST ════════════════════════════════════════════════════════════════
function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className=`toast show ${type}`;
  setTimeout(()=>{t.className='toast';},3200);
}

// ═══ TABS ══════════════════════════════════════════════════════════════════
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
  });
});

// ═══ ADMIN LOGIN ══════════════════════════════════════════════════════════
async function doAdminLogin(){
  const pass=document.getElementById('admin-pass-input').value;
  if(!pass) return;
  const btn=document.getElementById('admin-login-btn');
  btn.disabled=true; btn.textContent='...';
  try{
    const r=await fetch('/api/admin/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pass})});
    const d=await r.json();
    if(d.success){
      adminPassword=pass;
      document.getElementById('admin-login-overlay').style.display='none';
      document.getElementById('admin-panel').classList.add('visible');
      renderMatrix(activeYear);
      updateSummary();
      showToast('ברוך הבא, ועד הבית!');
    } else {
      document.getElementById('admin-login-error').style.display='block';
      document.getElementById('admin-login-error').textContent='סיסמה שגויה';
    }
  } catch(e){
    document.getElementById('admin-login-error').textContent='שגיאת רשת';
    document.getElementById('admin-login-error').style.display='block';
  } finally { btn.disabled=false; btn.textContent='כניסה למערכת'; }
}
document.getElementById('admin-login-btn').addEventListener('click',doAdminLogin);
document.getElementById('admin-pass-input').addEventListener('keydown',e=>{ if(e.key==='Enter') doAdminLogin(); });

// ═══ PAYMENT MATRIX ══════════════════════════════════════════════════════
function calcAptDebt(aptId){
  let debt=0;
  serverYears.forEach(year=>{
    const months=(year<currentYear)?12:(year===currentYear?currentMonth:0);
    for(let m=1;m<=months;m++){
      if(!payments[aptId][`${year}-${m}`]) debt+=serverMonthlyFee;
    }
  });
  return debt;
}

function renderMatrix(year){
  activeYear=year;
  document.querySelectorAll('.year-tab').forEach(t=>{
    t.classList.toggle('active', parseInt(t.dataset.year)===year);
  });

  const tbody=document.getElementById('matrix-body');
  tbody.innerHTML='';
  const monthsToShow=(year<currentYear)?12:(year===currentYear?currentMonth:0);

  serverApartments.forEach(apt=>{
    const tr=document.createElement('tr');
    let cols=`<td class="apt-th" style="font-size:0.82rem;">דירה ${apt.id}<br><span style="color:var(--text-dim);font-size:0.72rem;">${apt.ownerName||''}</span></td>`;
    for(let m=1;m<=12;m++){
      const key=`${year}-${m}`;
      if(m>monthsToShow){
        cols+=`<td><div class="pay-cell" style="background:var(--bg3);color:var(--text-dim);cursor:default;font-size:0.7rem;">—</div></td>`;
      } else {
        const paid=!!payments[apt.id][key];
        cols+=`<td><div class="pay-cell ${paid?'paid':'unpaid'}" data-apt="${apt.id}" data-key="${key}">${paid?'✓':'✗'}</div></td>`;
      }
    }
    const debt=calcAptDebt(apt.id);
    cols+=`<td style="text-align:center;font-weight:700;font-size:0.82rem;padding:6px;"><span style="color:${debt===0?'var(--green)':'var(--red)'};">${debt===0?'✓ שולם':'₪'+debt.toLocaleString()}</span></td>`;
    tr.innerHTML=cols;
    tbody.appendChild(tr);
  });

  // toggle on click
  tbody.querySelectorAll('.pay-cell[data-apt]').forEach(cell=>{
    cell.addEventListener('click',()=>{
      const aptId=parseInt(cell.dataset.apt);
      const key=cell.dataset.key;
      payments[aptId][key]=!payments[aptId][key];
      cell.className='pay-cell '+(payments[aptId][key]?'paid':'unpaid');
      cell.textContent=payments[aptId][key]?'✓':'✗';
      // update debt column
      const debt=calcAptDebt(aptId);
      const debtCell=cell.closest('tr').querySelector('td:last-child span');
      if(debtCell){ debtCell.style.color=debt===0?'var(--green)':'var(--red)'; debtCell.textContent=debt===0?'✓ שולם':'₪'+debt.toLocaleString(); }
      updateSummary();
      updateAptRowStatus(aptId);
    });
  });
}

document.getElementById('year-tabs').addEventListener('click',e=>{
  const btn=e.target.closest('.year-tab');
  if(btn) renderMatrix(parseInt(btn.dataset.year));
});

// Add year
document.getElementById('add-year-btn').addEventListener('click',async()=>{
  const maxY=Math.max(...serverYears);
  const newY=maxY+1;
  if(!confirm(`להוסיף את שנת ${newY}?`)) return;
  try{
    const r=await fetch('/api/admin/add-year',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,year:newY})});
    const d=await r.json();
    if(d.success){
      serverYears.push(newY); serverYears.sort((a,b)=>a-b);
      const btn=document.createElement('button');
      btn.className='year-tab'; btn.dataset.year=newY; btn.textContent=newY;
      document.getElementById('year-tabs').insertBefore(btn,document.getElementById('add-year-btn'));
      renderMatrix(newY);
      showToast(`שנת ${newY} נוספה!`);
    }
  }catch(e){ showToast('שגיאה','error'); }
});

// ═══ SUMMARY ══════════════════════════════════════════════════════════════
function updateSummary(){
  let clean=0,owed=0,total=0;
  serverApartments.forEach(a=>{
    const d=calcAptDebt(a.id);
    if(d===0) clean++; else { owed++; total+=d; }
  });
  document.getElementById('sum-clean').textContent=clean;
  document.getElementById('sum-owed').textContent=owed;
  document.getElementById('sum-total').textContent='₪'+total.toLocaleString();
  // monthly collected
  let possible=serverApartments.length*serverMonthlyFee;
  let collected=0;
  serverApartments.forEach(a=>{
    serverYears.forEach(year=>{
      const months=(year<currentYear)?12:(year===currentYear?currentMonth:0);
      for(let m=1;m<=months;m++){
        if(payments[a.id][`${year}-${m}`]) collected+=serverMonthlyFee;
      }
    });
  });
  document.getElementById('sum-monthly').textContent='₪'+collected.toLocaleString();
}

// ═══ APT ROW STATUS ═══════════════════════════════════════════════════════
function updateAptRowStatus(aptId){
  const badge=document.getElementById(`row-status-${aptId}`);
  if(!badge) return;
  const d=calcAptDebt(aptId);
  badge.className='badge '+(d===0?'badge-green':'badge-red');
  badge.textContent=d===0?'שולם':'₪'+d.toLocaleString();
}
function updateAllAptStatuses(){
  serverApartments.forEach(a=>updateAptRowStatus(a.id));
}

// Show password button
document.getElementById('apt-rows').addEventListener('click',e=>{
  const btn=e.target.closest('.show-pass-btn');
  if(!btn) return;
  const pass=btn.dataset.pass;
  const cell=document.getElementById(`cur-pass-${btn.closest('.apt-row').dataset.aptId}`);
  if(cell.textContent==='•••'){ cell.textContent=pass; btn.textContent='הסתר'; }
  else { cell.textContent='•••'; btn.textContent='הצג'; }
});

// ═══ SPECIAL CHARGES ══════════════════════════════════════════════════════
document.getElementById('sc-list').addEventListener('click',e=>{
  // toggle chip
  const chip=e.target.closest('.sc-chip');
  if(chip){
    chip.classList.toggle('paid');
    const apt=chip.dataset.apt;
    chip.textContent=chip.classList.contains('paid')?`✓ דירה ${apt}`:`○ דירה ${apt}`;
    return;
  }
  // delete
  const del=e.target.closest('.delete-sc-btn');
  if(del){
    const card=del.closest('.sc-card');
    if(!confirm('למחוק גבייה זו?')) return;
    fetch(`/api/admin/special/${card.dataset.scId}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword})})
      .then(r=>r.json()).then(d=>{ if(d.success){ card.remove(); showToast('נמחק'); }});
  }
});

document.getElementById('add-sc-btn').addEventListener('click',async()=>{
  const name=document.getElementById('sc-name').value.trim();
  const desc=document.getElementById('sc-desc').value.trim();
  const cost=document.getElementById('sc-cost').value;
  const date=document.getElementById('sc-date').value;
  if(!name){ showToast('הזן שם לגבייה','error'); return; }
  try{
    const r=await fetch('/api/admin/add-special',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,name,description:desc,costPerApartment:cost,date})});
    const d=await r.json();
    if(d.success){
      document.getElementById('sc-name').value='';
      document.getElementById('sc-desc').value='';
      document.getElementById('sc-cost').value='';
      document.getElementById('sc-date').value='';
      addScCardToDOM(d.charge);
      showToast('גבייה נוספה!');
    }
  }catch(e){ showToast('שגיאה','error'); }
});

function addScCardToDOM(sc){
  let chips='';
  for(let i=1;i<=20;i++) chips+=`<div class="sc-chip" data-apt="${i}">○ דירה ${i}</div>`;
  const dateInput=sc.date?`<input type="date" class="sc-date" value="${sc.date}" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;padding:7px 10px;">`
    :`<input type="date" class="sc-date" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem;padding:7px 10px;">`;
  const div=document.createElement('div');
  div.className='sc-card'; div.id=`sc-card-${sc.id}`; div.dataset.scId=sc.id;
  div.innerHTML=`
    <div class="sc-header">
      <input type="text" class="sc-name" value="${sc.name}" placeholder="שם">
      <input type="text" class="sc-desc" value="${sc.description||''}" placeholder="תיאור">
      <input type="number" class="sc-cost" value="${sc.costPerApartment}" min="0">
      ${dateInput}
      <button class="btn btn-danger btn-sm delete-sc-btn">🗑</button>
    </div>
    <div class="text-muted text-small">לחץ על דירה לסימון תשלום:</div>
    <div class="sc-chips">${chips}</div>`;
  document.getElementById('sc-list').appendChild(div);
}

// ═══ SAVE ALL ══════════════════════════════════════════════════════════════
async function saveAll(){
  const btn=document.getElementById('save-all-btn');
  btn.disabled=true; btn.textContent='...שומר';

  // check new admin pass
  const np1=document.getElementById('set-new-admin-pass').value;
  const np2=document.getElementById('set-new-admin-pass2').value;
  if(np1||np2){
    if(np1!==np2){ showToast('הסיסמאות אינן תואמות','error'); btn.disabled=false; btn.textContent='💾 שמור הכל'; return; }
    if(np1.length<4){ showToast('סיסמה חייבת להיות לפחות 4 תווים','error'); btn.disabled=false; btn.textContent='💾 שמור הכל'; return; }
  }

  // Collect apartments
  const apartments=[];
  document.querySelectorAll('#apt-rows .apt-row[data-apt-id]').forEach(row=>{
    const id=parseInt(row.dataset.aptId);
    const passVal=row.querySelector('.pass-input').value;
    apartments.push({
      id,
      ownerName: row.querySelector('.owner-input').value||'',
      note:      row.querySelector('.note-input').value||'',
      password:  passVal&&passVal.length>=4?passVal:'',
      payments:  payments[id]||{}
    });
  });

  // Collect special charges
  const specialCharges=[];
  document.querySelectorAll('#sc-list .sc-card').forEach(card=>{
    const paid=[];
    card.querySelectorAll('.sc-chip.paid').forEach(c=>paid.push({id:parseInt(c.dataset.apt),paid:true}));
    for(let i=1;i<=20;i++) if(!paid.find(p=>p.id===i)) paid.push({id:i,paid:false});
    specialCharges.push({
      id:               card.dataset.scId,
      name:             card.querySelector('.sc-name').value||'',
      description:      card.querySelector('.sc-desc').value||'',
      costPerApartment: parseInt(card.querySelector('.sc-cost').value)||0,
      date:             card.querySelector('.sc-date').value||'',
      apartments:       paid
    });
  });

  // Settings
  const settings={
    buildingName:    document.getElementById('set-bname').value,
    buildingAddress: document.getElementById('set-baddress').value,
    monthlyFee:      document.getElementById('set-fee').value,
    bankDetails:{
      bank:        document.getElementById('set-bank').value,
      branch:      document.getElementById('set-branch').value,
      account:     document.getElementById('set-account').value,
      beneficiary: document.getElementById('set-beneficiary').value
    },
    payboxLink: document.getElementById('set-paybox').value,
    years: serverYears
  };
  if(np1) settings.newAdminPassword=np1;

  try{
    const r=await fetch('/api/admin/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminPassword,apartments,specialCharges,settings})});
    const d=await r.json();
    if(d.success){
      if(np1){ adminPassword=np1; showToast('✓ נשמר! הסיסמה עודכנה'); }
      else showToast('✓ '+d.message);
      document.getElementById('set-new-admin-pass').value='';
      document.getElementById('set-new-admin-pass2').value='';
      // clear new-password fields in apt rows
      document.querySelectorAll('.pass-input').forEach(i=>i.value='');
      updateAllAptStatuses();
      updateSummary();
    } else {
      showToast(d.message||'שגיאה','error');
    }
  }catch(e){ showToast('שגיאת רשת','error'); }
  finally{ btn.disabled=false; btn.textContent='💾 שמור הכל'; }
}

document.getElementById('save-all-btn').addEventListener('click',saveAll);
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key==='s'){
    e.preventDefault();
    if(document.getElementById('admin-panel').classList.contains('visible')) saveAll();
  }
});
</script>
</body>
</html>
