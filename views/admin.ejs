function autoFillDeferred() {
  const aptNum = document.getElementById('dAptId').value;
  const r = appData.residents.find(x => String(x.number) === String(aptNum));
  if (r) {
    const type = appData.settings.apartmentTypes.find(t => t.id === r.typeId);
    if (type) document.getElementById('dAmount').value = type.monthlyFee;
  }
  buildDeferredPreview();
}

function buildDeferredPreview() {
  const n = parseInt(document.getElementById('dNumMonths').value) || 1;
  const startM = parseInt(document.getElementById('dStartMonth').value);
  const startY = parseInt(document.getElementById('dStartYear').value);
  const amount = Number(document.getElementById('dAmount').value);
  if (n > 1) {
    let checks = [];
    for (let i = 0; i < n; i++) {
      const d = new Date(startY, startM - 1 + i);
      checks.push(`${MONTHS[d.getMonth()]} ${d.getFullYear()} – ₪${amount.toLocaleString()}`);
    }
    const el = document.getElementById('deferredPreview');
    el.innerHTML = `${n} המחאות: ${checks.join(' | ')}`;
    el.style.display = 'flex';
  } else {
    document.getElementById('deferredPreview').style.display = 'none';
  }
}

async function saveDeferred() {
  const aptNumber = document.getElementById('dAptId').value;
  const amount = Number(document.getElementById('dAmount').value);
  const n = parseInt(document.getElementById('dNumMonths').value) || 1;
  const startM = parseInt(document.getElementById('dStartMonth').value);
  const startY = parseInt(document.getElementById('dStartYear').value);
  const checkNum = document.getElementById('dCheckNum').value;

  const checks = [];
  for (let i = 0; i < n; i++) {
    const d = new Date(startY, startM - 1 + i);
    // Due date = first of that month
    const dueDate = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-01`;
    checks.push({ aptNumber, checkNum: checkNum + (n > 1 ? `/${i+1}` : ''), amount, forMonth: d.getMonth()+1, forYear: d.getFullYear(), dueDate, cashed: false });
  }

  const res = await fetch('/api/deferred', {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(checks)
  });
  if (res.ok) {
    await refreshData();
    renderDeferred();
    renderDashboard();
    closeModal('deferredModal');
    showToast('ההמחאות נרשמו', 'success');
  }
}

