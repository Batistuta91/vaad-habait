function autoFillAmount() {
  const aptNum = document.getElementById('tAptId').value;
  const r = appData.residents.find(x => String(x.number) === String(aptNum));
  if (r) {
    const type = appData.settings.apartmentTypes.find(t => t.id === r.typeId);
    if (type) document.getElementById('tAmount').value = type.monthlyFee;
  }
}

function updateMultiMonth() {
  const months = parseInt(document.getElementById('tMonths').value) || 1;
  const startMonth = parseInt(document.getElementById('tMonth').value);
  const startYear = parseInt(document.getElementById('tYear').value);
  const amount = Number(document.getElementById('tAmount').value);
  if (months > 1) {
    let preview = `תשלום ל-${months} חודשים | סה"כ: ₪${(months*amount).toLocaleString()}<br>`;
    for (let i = 0; i < months; i++) {
      const d = new Date(startYear, startMonth - 1 + i);
      preview += `${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
      if (i < months-1) preview += ', ';
    }
    const el = document.getElementById('multiMonthPreview');
    el.innerHTML = preview; el.style.display = 'flex';
  } else {
    document.getElementById('multiMonthPreview').style.display = 'none';
  }
}

async function saveTransaction(andPrint = false) {
  const aptNumber = document.getElementById('tAptId').value;
  const amount = Number(document.getElementById('tAmount').value);
  const numMonths = parseInt(document.getElementById('tMonths').value) || 1;
  const startMonth = parseInt(document.getElementById('tMonth').value);
  const startYear = parseInt(document.getElementById('tYear').value);
  const method = document.getElementById('tMethod').value;
  const note = document.getElementById('tNote').value;

  let months = [];
  for (let i = 0; i < numMonths; i++) {
    const d = new Date(startYear, startMonth - 1 + i);
    months.push({ month: d.getMonth() + 1, year: d.getFullYear(), amount });
  }

  const body = { aptNumber, type: 'income', method, note, months };
  const res = await fetch('/api/transactions', {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
  });
  if (res.ok) {
    const created = await res.json();
    await refreshData();
    renderTransactions();
    renderDashboard();
    closeModal('transactionModal');
    showToast('התשלום נרשם', 'success');
    if (andPrint && created.length > 0) {
      showReceipt(created[0].id);
    }
  }
}

function saveAndPrintReceipt() { saveTransaction(true); }

