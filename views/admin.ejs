function renderDeferred() {
  const checks = [...appData.deferredChecks].sort((a,b) => new Date(a.dueDate) - new Date(b.dueDate));
  if (!checks.length) {
    document.getElementById('deferredContent').innerHTML = '<div class="empty-state"><div class="empty-icon">📅</div><p>אין המחאות דחויות</p></div>';
    return;
  }
  let html = '<div class="table-wrap"><table><thead><tr><th>דירה</th><th>מס׳ המחאה</th><th>סכום</th><th>חודש</th><th>תאריך פירעון</th><th>סטטוס</th><th>פעולות</th></tr></thead><tbody>';
  checks.forEach(d => {
    const overdue = !d.cashed && new Date(d.dueDate) < new Date();
    const soon = !d.cashed && new Date(d.dueDate) <= new Date(Date.now() + 15*24*60*60*1000);
    html += `<tr>
      <td>דירה ${d.aptNumber}</td>
      <td dir="ltr">${d.checkNum || '-'}</td>
      <td class="text-bold">₪${Number(d.amount).toLocaleString()}</td>
      <td>${d.forMonth ? MONTHS[d.forMonth-1]+' '+d.forYear : '-'}</td>
      <td class="${overdue ? 'text-danger text-bold' : soon ? 'text-warning' : ''}">${formatDate(d.dueDate)}</td>
      <td>${d.cashed ? '<span class="badge badge-success">הופקד ✅</span>' : overdue ? '<span class="badge badge-danger">באיחור!</span>' : '<span class="badge badge-warning">ממתין</span>'}</td>
      <td>
        <div class="flex gap-1">
          ${!d.cashed ? `<button class="btn btn-sm btn-success" onclick="cashCheck('${d.id}')">הפקד</button>` : ''}
          <button class="btn-icon" onclick="deleteDeferred('${d.id}')">🗑️</button>
        </div>
      </td>
    </tr>`;
  });
  html += '</tbody></table></div>';
  document.getElementById('deferredContent').innerHTML = html;
}

function openDeferredModal() {
  const sel = document.getElementById('dAptId');
  sel.innerHTML = [...appData.residents].sort((a,b)=>a.number-b.number)
    .map(r => `<option value="${r.number}">${r.number} – ${r.lastName} ${r.firstName}</option>`).join('');
