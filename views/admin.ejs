// ══ INLINE PARTIAL EDITOR ════════════════════════════════════════════════
// Opens a mini editor INSIDE the cell itself — no popup, no overlay.
// Right-click (desktop) or long-press (mobile) activates it.

let activeInlineCell = null;

function openInlineEditor(cell) {
  // Close any existing editor first
  closeInlineEditor();

  activeInlineCell = cell;
  const aptId = parseInt(cell.dataset.apt);
  const key   = cell.dataset.key;
  const [yr, mn] = key.split('-');
  const cur   = payments[aptId][key] || 0;

  // Save original cell content to restore on cancel
  cell.dataset.origHtml = cell.innerHTML;

  // Build inline editor HTML
  cell.innerHTML = `
    <div class="inline-editor" onclick="event.stopPropagation()">
      <div class="ie-label">₪ / ${serverMonthlyFee}</div>
      <input class="ie-input" type="number" min="0" max="${serverMonthlyFee}"
             value="${cur > 0 ? cur : ''}" placeholder="${serverMonthlyFee}"
             inputmode="numeric" id="ie-inp-${aptId}-${mn}">
      <div class="ie-btns">
        <button class="ie-btn ie-cancel" title="ביטול">✕</button>
        <button class="ie-btn ie-full"   title="שולם מלא">✓</button>
        <button class="ie-btn ie-save"   title="שמור">💾</button>
      </div>
    </div>`;

  cell.classList.add('editing');

  const inp = cell.querySelector('.ie-input');
  inp.focus();
  inp.select();

  // Save on Enter, cancel on Escape
  inp.addEventListener('keydown', e => {
    if (e.key === 'Enter')  { e.preventDefault(); saveInline(cell); }
    if (e.key === 'Escape') { e.preventDefault(); closeInlineEditor(); }
  });

  cell.querySelector('.ie-save').addEventListener('click',   e => { e.stopPropagation(); saveInline(cell); });
  cell.querySelector('.ie-full').addEventListener('click',   e => { e.stopPropagation(); saveInlineFull(cell); });
  cell.querySelector('.ie-cancel').addEventListener('click', e => { e.stopPropagation(); closeInlineEditor(); });
}

function saveInline(cell) {
  const inp   = cell.querySelector('.ie-input');
  if (!inp) return;
  const aptId = parseInt(cell.dataset.apt);
  const key   = cell.dataset.key;
  const val   = Math.min(Math.max(parseInt(inp.value) || 0, 0), serverMonthlyFee);
  payments[aptId][key] = val;
  activeInlineCell = null;          // clear BEFORE refreshCell so close-outside won't re-trigger
  cell.classList.remove('editing');
  refreshCell(cell, aptId, key);
  refreshMarkAllBtn(cell.closest('tr'), aptId, parseInt(cell.dataset.year),
    parseInt(cell.dataset.year) < currentYear ? 12 : currentMonth);
  updateDebtCell(aptId);
  updateSummary();
}

function saveInlineFull(cell) {
  const aptId = parseInt(cell.dataset.apt);
  const key   = cell.dataset.key;
  payments[aptId][key] = serverMonthlyFee;
  activeInlineCell = null;
  cell.classList.remove('editing');
  refreshCell(cell, aptId, key);
  refreshMarkAllBtn(cell.closest('tr'), aptId, parseInt(cell.dataset.year),
    parseInt(cell.dataset.year) < currentYear ? 12 : currentMonth);
  updateDebtCell(aptId);
  updateSummary();
}

function closeInlineEditor() {
  if (!activeInlineCell) return;
  const cell  = activeInlineCell;
  const aptId = parseInt(cell.dataset.apt);
  const key   = cell.dataset.key;
  activeInlineCell = null;
  cell.classList.remove('editing');
  refreshCell(cell, aptId, key);
}

// Close editor only on click OUTSIDE the matrix entirely
document.addEventListener('click', e => {
  if (!activeInlineCell) return;
  if (!e.target.closest('#payments-matrix')) {
    closeInlineEditor();
  }
});

