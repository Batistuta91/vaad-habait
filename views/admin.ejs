function renderExpenses() {
  const expenses = appData.transactions.filter(t => t.type === 'expense').sort((a,b)=>{ const da=new Date(a.year,(a.month||1)-1); const db=new Date(b.year,(b.month||1)-1); return db-da; });
  if (!expenses.length) {
    document.getElementById('expensesContent').innerHTML = '<div class="empty-state"><div class="empty-icon">💸</div><p>אין הוצאות</p></div>';
    return;
  }
  let html = '<div class="table-wrap"><table><thead><tr><th>חודש/שנה</th><th>סכום</th><th>ספק/שירות</th><th>אמצעי</th><th>פירוט</th><th>פעולות</th></tr></thead><tbody>';
  expenses.forEach(e => {
    const svc = e.serviceId ? appData.serviceTransactions.find(s => s.id === e.serviceId) : null;
    html += `<tr>
      <td>${MONTHS[(e.month||1)-1]} ${e.year}</td>
      <td class="text-danger text-bold">-₪${Number(e.amount).toLocaleString()}</td>
      <td>${svc ? svc.name : '-'}</td>
      <td>${methodName(e.method)}</td>
      <td class="text-sm text-muted">${e.note || ''}</td>
      <td><button class="btn-icon" onclick="deleteTransaction('${e.id}')">🗑️</button></td>
    </tr>`;
  });
  html += '</tbody></table></div>';
  document.getElementById('expensesContent').innerHTML = html;
}

