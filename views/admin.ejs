    <input type="number" class="sc-cost" value="${sc.costPerApartment}" min="0" style="width:100px;">
    <input type="date" class="sc-date" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.84rem;padding:7px 10px;width:138px;">
