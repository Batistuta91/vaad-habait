// ═══════════════════════════════════════════════════════════════
//  PROJECTS (one-time)
// ═══════════════════════════════════════════════════════════════
function renderProjects() {
  const projects = appData.oneTimeProjects;
  if (!projects.length) {
    document.getElementById('projectsContent').innerHTML = '<div class="empty-state"><div class="empty-icon">🎯</div><p>אין פרויקטים</p></div>';
    return;
  }

  let html = '';
  projects.forEach(p => {
    const residents = [...appData.residents].sort((a,b) => a.number - b.number);
    const paidCount = residents.filter(r => p.paidStatus && p.paidStatus[r.id]).length;
    const totalCount = residents.length;
    const pct = Math.round((paidCount / totalCount) * 100);

    html += `<div class="card mb-2">
      <div class="card-header">
        <div class="card-title">🎯 ${p.name}</div>
        <div class="flex gap-1">
          <span class="badge badge-neutral">₪${Number(p.amount).toLocaleString()}/דירה</span>
          <button class="btn-icon" onclick="deleteProject('${p.id}')">🗑️</button>
        </div>
      </div>
      <div class="mb-2">
        <div class="flex-between mb-1"><span class="text-sm">שילמו ${paidCount}/${totalCount} דירות</span><span class="text-sm text-bold">${pct}%</span></div>
        <div class="progress-wrap"><div class="progress-bar ${pct < 50 ? 'danger' : pct < 80 ? 'warning' : ''}" style="width:${pct}%"></div></div>
      </div>
      <div class="chip-grid">`;

    residents.forEach(r => {
      const paid = p.paidStatus && p.paidStatus[r.id];
      html += `<div class="chip ${paid ? 'paid' : 'unpaid'}" onclick="toggleProjectPay('${p.id}','${r.id}')">
        ${paid ? '✅' : '❌'} דירה ${r.number}
      </div>`;
    });

    html += `</div>
      ${p.note ? `<p class="text-sm text-muted mt-2">${p.note}</p>` : ''}
      ${p.dueDate ? `<p class="text-sm text-muted">יעד: ${formatDate(p.dueDate)}</p>` : ''}
    </div>`;
  });

  document.getElementById('projectsContent').innerHTML = html;
}

