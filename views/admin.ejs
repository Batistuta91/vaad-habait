// ═══ FINANCE ══════════════════════════════════════════════════════════════
function calcFinSummary(){
  const opening = parseInt(document.getElementById('opening-balance-input').value) || 0;
  const income  = txList.filter(t=>t.type==='income').reduce((s,t)=>s+(t.amount||0),0);
  const expense = txList.filter(t=>t.type==='expense').reduce((s,t)=>s+(t.amount||0),0);
  const balance = opening + income - expense;

  document.getElementById('fin-opening').textContent  = '₪'+opening.toLocaleString();
  document.getElementById('fin-income').textContent   = '+₪'+income.toLocaleString();
  document.getElementById('fin-expense').textContent  = '-₪'+expense.toLocaleString();
  const balEl = document.getElementById('fin-balance');
  balEl.textContent = (balance>=0?'+':'') + '₪'+Math.abs(balance).toLocaleString();
  balEl.style.color = balance>=0 ? 'var(--gold)' : 'var(--red)';
  document.getElementById('fin-formula').textContent =
    `יתרה = ₪${opening.toLocaleString()} (פתיחה) + ₪${income.toLocaleString()} (הכנסות) − ₪${expense.toLocaleString()} (הוצאות) = ${balance>=0?'+':''}₪${Math.abs(balance).toLocaleString()}`;
}

function renderTxRow(tx){
  const tr=document.createElement('tr');
  tr.dataset.txId=tx.id;
  tr.innerHTML=`
    <td style="color:var(--text-muted);font-size:0.8rem;white-space:nowrap;">${tx.date||'—'}</td>
    <td><span class="badge ${tx.type==='income'?'badge-green':'badge-red'}">${tx.type==='income'?'הכנסה':'הוצאה'}</span></td>
    <td>${tx.category||'—'}</td>
    <td>${tx.description||'—'}</td>
    <td class="${tx.type==='income'?'tx-income':'tx-expense'}">${tx.type==='income'?'+':'-'}₪${(tx.amount||0).toLocaleString()}</td>
    <td><button class="btn btn-danger btn-sm delete-tx-btn" style="padding:4px 10px;">🗑</button></td>`;
  return tr;
}

document.getElementById('opening-balance-input').addEventListener('input', calcFinSummary);

document.getElementById('add-tx-btn').addEventListener('click',()=>{
  const type   = document.getElementById('tx-type').value;
  const cat    = document.getElementById('tx-cat').value.trim();
  const desc   = document.getElementById('tx-desc').value.trim();
  const amount = parseInt(document.getElementById('tx-amount').value)||0;
  const date   = document.getElementById('tx-date').value;
  if(!amount){ showToast('הזן סכום','error'); return; }
  if(!desc)  { showToast('הזן תיאור','error'); return; }
  const tx = { id:'tx_'+Date.now(), type, category:cat, description:desc, amount, date };
  txList.push(tx);
  // Insert sorted by date desc
  const sorted=[...txList].sort((a,b)=>new Date(b.date)-new Date(a.date));
  const tbody=document.getElementById('tx-body');
  tbody.innerHTML='';
  sorted.forEach(t=>tbody.appendChild(renderTxRow(t)));
  calcFinSummary();
  ['tx-cat','tx-desc','tx-amount'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('tx-date').value='';
  showToast(`${type==='income'?'הכנסה':'הוצאה'} נוספה!`);
});

document.getElementById('tx-body').addEventListener('click',e=>{
  const btn=e.target.closest('.delete-tx-btn');
  if(!btn) return;
  const row=btn.closest('tr');
  const id=row.dataset.txId;
  if(!confirm('למחוק פעולה זו?')) return;
  txList=txList.filter(t=>t.id!==id);
  row.remove();
  calcFinSummary();
  showToast('נמחק');
});

// SAVE ALL
async function saveAll(){
  const btn=document.getElementById('save-all-btn');
  btn.disabled=true;btn.textContent='...שומר';

  const np1=document.getElementById('set-new-pass').value;
  const np2=document.getElementById('set-new-pass2').value;
  if(np1||np2){
    if(np1!==np2){showToast('סיסמאות אינן תואמות','error');btn.disabled=false;btn.textContent='💾 שמור הכל';return;}
    if(np1.length<4){showToast('סיסמה קצרה מדי','error');btn.disabled=false;btn.textContent='💾 שמור הכל';return;}
  }

  // Apartments
  const apartments=[];
  document.querySelectorAll('.apt-grid-v2[data-apt-id]').forEach(row=>{
    const id=parseInt(row.dataset.aptId);
    const pv=row.querySelector('.pass-input')?row.querySelector('.pass-input').value:'';
    apartments.push({id,
      ownerName:  row.querySelector('.owner-input').value||'',
      phone:      row.querySelector('.phone-input')?row.querySelector('.phone-input').value||'':'',
      ownerType:  row.querySelector('.type-select').value||'owner',
      tenantName: row.querySelector('.tenant-input')?row.querySelector('.tenant-input').value||'':'',
      note:       row.querySelector('.note-input')?row.querySelector('.note-input').value||'':'',
      password:   pv&&pv.length>=4?pv:'',
      payments:   payments[id]||{}
    });
  });

  // Special charges
  const specialCharges=[];
  document.querySelectorAll('#sc-list .sc-card').forEach(card=>{
    const paid=[];
    for(let i=1;i<=20;i++){
      const chip=card.querySelector(`.sc-chip[data-apt="${i}"]`);
      paid.push({id:i,paid:chip?chip.classList.contains('paid'):false});
    }
    specialCharges.push({id:card.dataset.scId,
      name:card.querySelector('.sc-name').value||'',
      description:card.querySelector('.sc-desc').value||'',
      costPerApartment:parseInt(card.querySelector('.sc-cost').value)||0,
      date:card.querySelector('.sc-date').value||'',
      apartments:paid
    });
  });

  // Announcements
  const announcements=[];
  document.querySelectorAll('#ann-list .ann-admin-card').forEach(card=>{
    announcements.push({
      id:card.dataset.annId||('ann_'+Date.now()),
      title:card.querySelector('.ann-title-input').value||'',
      body:card.querySelector('.ann-body-input').value||'',
      icon:card.querySelector('.ann-icon-input').value||'📢',
      active:card.querySelector('.ann-active-chk').checked
    });
  });

  // Settings
  const settings={
    buildingName:        document.getElementById('set-bname').value,
    buildingAddress:     document.getElementById('set-baddress').value,
    monthlyFee:          document.getElementById('set-fee').value,
    openingBalance:      parseInt(document.getElementById('opening-balance-input').value) || 0,
    showPublicDebts:     document.getElementById('set-show-debts').checked,
    showFinancialReport: document.getElementById('set-show-finance').checked,
    bankDetails:{
      bank:        document.getElementById('set-bank').value,
      branch:      document.getElementById('set-branch').value,
      account:     document.getElementById('set-account').value,
      beneficiary: document.getElementById('set-beneficiary').value
    },
    payboxLink: document.getElementById('set-paybox').value,
    years: serverYears
  };
  if(np1) settings.newAdminPassword=np1;

  try{
    const r=await fetch('/api/admin/save',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({adminPassword,apartments,specialCharges,settings,announcements,transactions:txList})});
    const d=await r.json();
    if(d.success){
      if(np1) adminPassword=np1;
      serverMonthlyFee=parseInt(document.getElementById('set-fee').value)||serverMonthlyFee;
      showToast('✓ '+d.message);
      document.getElementById('set-new-pass').value='';
      document.getElementById('set-new-pass2').value='';
      document.querySelectorAll('.pass-input').forEach(i=>i.value='');
      updateAllAptStatuses();updateSummary();
    } else showToast(d.message||'שגיאה','error');
  }catch(e){showToast('שגיאת רשת','error');}
  finally{btn.disabled=false;btn.textContent='💾 שמור הכל';}
}

document.getElementById('save-all-btn').addEventListener('click',saveAll);

