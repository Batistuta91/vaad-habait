// ══ RESTORE ══════════════════════════════════════════════════════════════
document.getElementById('restore-file').addEventListener('change', async e=>{
  const file = e.target.files[0];
  if(!file) return;
  const statusEl = document.getElementById('restore-status');
  statusEl.style.display = 'block';
  statusEl.style.color   = 'var(--text-muted)';
  statusEl.textContent   = '📂 קורא קובץ...';

  try {
    const text = await file.text();
    const data = JSON.parse(text);

    if(!data.apartments || !data.adminPassword){
      statusEl.style.color = 'var(--red)';
      statusEl.textContent = '❌ קובץ לא תקין — חסרים שדות חובה';
      return;
    }

    if(!confirm(`לשחזר נתונים מ-${file.name}?\n\nפעולה זו תחליף את כל הנתונים הקיימים!`)){
      statusEl.style.display = 'none';
      e.target.value = '';
      return;
    }

    statusEl.textContent = '⏳ משחזר...';
    const r = await fetch('/api/admin/import', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ adminPassword, data })
    });
    const res = await r.json();
    if(res.success){
      statusEl.style.color = 'var(--green)';
      statusEl.textContent = '✅ ' + res.message + ' — מרענן דף...';
      setTimeout(()=>location.reload(), 1500);
    } else {
      statusEl.style.color = 'var(--red)';
      statusEl.textContent = '❌ ' + (res.message||'שגיאה');
    }
  } catch(err){
    statusEl.style.color = 'var(--red)';
    statusEl.textContent = '❌ קובץ JSON לא תקין';
  }
  e.target.value = '';
});
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key==='s'){
    e.preventDefault();
    if(document.getElementById('admin-panel').classList.contains('visible')) saveAll();
  }
});
