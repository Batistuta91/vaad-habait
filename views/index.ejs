<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= buildingName %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%=cssVersion%>">
  <script>
    var _t = localStorage.getItem('vaad_theme') || 'light';
    if (_t === 'light') {
      document.documentElement.classList.add('pre-light');
      document.addEventListener('DOMContentLoaded', function(){
        document.body.classList.add('light');
      });
    }
  </script>
  <style>
  html.pre-light body{ background:#f5f6fa!important; color:#1a1e2e!important; }
  html.pre-light .site-header{ background:#ffffff!important; }
  html.pre-light .unified-login-card{ background:#ffffff!important; }
  html.pre-light .ann-bar{ background:#eef0f6!important; }

  /* ── UNIFIED LOGIN CARD ── */
  .unified-login-wrap{
    display:flex;justify-content:center;
    padding:8px 0 24px;
  }
  .unified-login-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:36px 32px 32px;
    width:100%;max-width:400px;
    box-shadow:var(--shadow-lg);
    text-align:center;
  }
  @media(max-width:480px){
    .unified-login-card{ padding:28px 18px 24px; border-radius:12px; }
    .page-hero{ padding:16px 14px 12px; }
    .unified-login-wrap{ padding:4px 0 16px; }
  }
  .ulogin-icon{font-size:3rem;margin-bottom:14px;display:block;}
  .ulogin-title{
    font-family:'Frank Ruhl Libre',serif;
    font-size:1.6rem;font-weight:900;
    color:var(--text);margin-bottom:4px;
  }
  .ulogin-sub{
    font-size:0.82rem;color:var(--text-muted);
    margin-bottom:24px;
  }

  /* type selector */
  .ulogin-type-row{
    display:flex;gap:8px;margin-bottom:24px;
    background:var(--bg2);border-radius:var(--radius-sm);
    padding:5px;border:1px solid var(--border);
  }
  .ulogin-type-btn{
    flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;
    padding:10px 8px;border-radius:8px;border:none;
    background:transparent;color:var(--text-muted);
    font-family:'Heebo',sans-serif;font-size:0.85rem;font-weight:600;
    cursor:pointer;transition:var(--transition);
  }
  .ulogin-type-btn.active{
    background:var(--gold);color:#111;
    box-shadow:0 2px 10px rgba(245,200,66,0.3);
  }
  .ulogin-type-icon{font-size:1.3rem;}

  /* fields */
  .ulogin-field{
    text-align:right;margin-bottom:16px;
  }
  .ulogin-field label{
    display:block;font-size:0.8rem;font-weight:700;
    color:var(--text-muted);text-transform:uppercase;
    letter-spacing:0.05em;margin-bottom:7px;
  }
  .ulogin-select,.ulogin-input{
    width:100%;background:var(--bg2);
    border:1px solid var(--border-strong);
    border-radius:var(--radius-sm);
    color:var(--text);font-family:'Heebo',sans-serif;
    font-size:1rem;padding:12px 14px;
    direction:rtl;transition:var(--transition);
  }
  .ulogin-select:focus,.ulogin-input:focus{
    outline:none;border-color:var(--gold);
    box-shadow:0 0 0 3px var(--gold-dim);
  }
  .ulogin-error{
    color:var(--red);font-size:0.85rem;
    margin:0 0 14px;padding:10px 14px;
    background:var(--red-dim);border-radius:var(--radius-sm);
    border:1px solid rgba(239,68,68,0.3);
    text-align:right;
  }
  .ulogin-btn{
    margin-top:4px;padding:14px;font-size:1rem;
  }

  /* ── ANNOUNCEMENTS ── */
  .ann-bar{background:var(--bg2);border-bottom:1px solid var(--border);overflow:hidden;}
  .ann-inner{max-width:1100px;margin:0 auto;padding:0;display:flex;flex-direction:column;}
  .ann-item{display:flex;align-items:flex-start;gap:10px;padding:11px 16px;border-bottom:1px solid var(--border);width:100%;box-sizing:border-box;}
  .ann-item:last-child{border-bottom:none;}
  .ann-icon{font-size:1.1rem;flex-shrink:0;margin-top:2px;}
  .ann-text{min-width:0;flex:1;overflow:hidden;}
  .ann-text strong{font-size:0.83rem;font-weight:700;color:var(--text);display:block;margin-bottom:2px;}
  .ann-text span{font-size:0.76rem;color:var(--text-muted);line-height:1.5;display:block;word-wrap:break-word;overflow-wrap:break-word;}

  /* ── FINANCIAL REPORT ── */
  .fin-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;}
  @media(max-width:560px){.fin-summary{grid-template-columns:1fr 1fr;}}
  .fin-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px;text-align:center;}
  .fin-val{font-size:1.4rem;font-weight:900;font-family:'Frank Ruhl Libre',serif;}
  .fin-lbl{font-size:0.72rem;color:var(--text-muted);margin-top:3px;text-align:center;}
  .tx-table{width:100%;border-collapse:collapse;font-size:0.84rem;}
  .tx-table th{background:var(--bg);color:var(--text-muted);font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:9px 12px;text-align:right;border-bottom:2px solid var(--border);}
  .tx-table td{padding:9px 12px;border-bottom:1px solid var(--border);text-align:right;vertical-align:middle;}
  .tx-table tr:last-child td{border-bottom:none;}
  .tx-table tr:hover td{background:rgba(255,255,255,0.02);}
  .tx-type-income{color:var(--green);font-weight:700;}
  .tx-type-expense{color:var(--red);font-weight:700;}

  /* ── PUBLIC HIDDEN ── */
  .public-hidden-msg{text-align:center;padding:32px;color:var(--text-muted);font-size:0.92rem;
    background:var(--bg2);border-radius:var(--radius);border:1px dashed var(--border-strong);}
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🏢</div>
      <div class="logo-text">
        <%= buildingName %>
        <span><%= buildingAddress %></span>
      </div>
    </div>
    <nav class="header-nav" style="display:flex;align-items:center;gap:10px;">
      <button class="theme-toggle" id="theme-toggle-btn">
        <span id="theme-icon">☀️</span>
        <div class="toggle-track"><div class="toggle-thumb"></div></div>
        <span id="theme-label">בהיר</span>
      </button>
      <button id="header-logout-btn" style="display:none;" class="btn btn-outline btn-sm" style="font-size:0.8rem;">
        ↩ התנתק
      </button>
    </nav>
  </div>
</header>

<!-- ANNOUNCEMENTS -->
<% if(announcements && announcements.length > 0){ %>
<div class="ann-bar">
  <div class="ann-inner">
    <% announcements.forEach(ann=>{ %>
    <div class="ann-item">
      <span class="ann-icon"><%=ann.icon%></span>
      <div class="ann-text">
        <strong><%=ann.title%></strong>
        <span><%=ann.body%></span>
      </div>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<div class="page-hero">
  <h1>שקיפות <span>פיננסית</span> לכולם</h1>
  <p>מצב חוב עדכני • היסטוריית תשלומים • תשלום נוח</p>
</div>

<main class="container" style="padding-bottom:60px;">

  <!-- ══ UNIFIED LOGIN CARD ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="unified-login-wrap">
      <div class="unified-login-card" id="login-card">

        <div class="ulogin-icon">🔐</div>
        <h2 class="ulogin-title">כניסה למערכת</h2>
        <p class="ulogin-sub"><%= buildingName %></p>

        <!-- WHO ARE YOU -->
        <div class="ulogin-type-row">
          <button class="ulogin-type-btn active" id="type-tenant" onclick="setLoginType('tenant')">
            <span class="ulogin-type-icon">🏠</span>
            <span>דייר</span>
          </button>
          <button class="ulogin-type-btn" id="type-admin" onclick="setLoginType('admin')">
            <span class="ulogin-type-icon">👑</span>
            <span>ועד בית</span>
          </button>
        </div>

        <!-- TENANT FIELDS -->
        <div id="tenant-fields">
          <div class="ulogin-field">
            <label>מספר דירה</label>
            <select id="apt-select" class="ulogin-select">
              <option value="">— בחר דירה —</option>
              <% for(let i=1;i<=20;i++){%>
              <option value="<%=i%>">דירה <%=i%></option>
              <%}%>
            </select>
          </div>
          <div class="ulogin-field">
            <label>סיסמה</label>
            <input type="password" id="apt-password" class="ulogin-input"
                   placeholder="הזן סיסמה" autocomplete="current-password">
          </div>
        </div>

        <!-- ADMIN FIELDS -->
        <div id="admin-fields" style="display:none;">
          <div class="ulogin-field">
            <label>סיסמת ועד בית</label>
            <input type="password" id="admin-password" class="ulogin-input"
                   placeholder="הזן סיסמת מנהל">
          </div>
        </div>

        <div id="login-error" class="ulogin-error" style="display:none;"></div>

        <button class="btn btn-primary btn-full ulogin-btn" id="login-btn">כניסה</button>

      </div>
    </div>

    <!-- PERSONAL AREA — hidden until explicit login -->
    <div id="personal-area" style="display:none;" class="mt-16">
      <div class="personal-card">
        <div class="apt-badge" id="pa-num">?</div>
        <div class="personal-info">
          <div class="apt-label" id="pa-owner"></div>
          <div id="pa-debt-badge" class="debt-badge zero mt-8">✓ אין חוב</div>
          <div id="pa-breakdown" style="display:none;font-size:0.82rem;color:var(--text-muted);margin-top:6px;"></div>
          <div class="apt-note mt-12" id="pa-note" style="display:none;"></div>
        </div>
        <button class="btn btn-ghost btn-sm" id="logout-btn">↩ יציאה</button>
      </div>

      <div class="card mt-16">
        <h3 class="section-title" style="font-size:1rem;">היסטוריית תשלומים חודשיים</h3>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;font-size:0.78rem;">
          <span style="color:var(--green);">✓ שולם מלא</span>
          <span style="color:var(--gold);">~ חלקי</span>
          <span style="color:var(--red);">✗ לא שולם</span>
        </div>
        <div id="pa-monthly-grid" class="monthly-grid"></div>
      </div>

      <div id="pa-special-section" style="display:none;" class="card mt-16">
        <h3 class="section-title" style="font-size:1rem;">גביות מיוחדות</h3>
        <div id="pa-special-list"></div>
      </div>

      <!-- PHONEBOOK -->
      <div class="card mt-16" id="pa-phonebook-section" style="display:none;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
          <h3 class="section-title" style="font-size:1rem;margin-bottom:0;">📞 ספר טלפונים — דיירי הבניין</h3>
          <button class="btn btn-outline btn-sm" id="print-phonebook-btn">🖨️ הדפסה</button>
        </div>
        <div id="pa-phonebook-list"></div>
      </div>

    </div>
  </section>

  <div class="divider"></div>

  <!-- ══ PUBLIC TABLE ════════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">
      שקיפות ציבורית — סטטוס כל הדירות
      <span class="badge badge-gold" style="margin-right:auto;">מידע עדכני</span>
    </h2>
    <% if(showPublicDebts){ %>
    <div class="card">
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;font-size:0.82rem;">
        <span style="color:var(--green);">● ירוק = ללא חוב</span>
        <span style="color:var(--red);">● אדום = יש חוב</span>
        <span class="text-muted" style="margin-right:auto;">מספרי דירות בלבד</span>
      </div>
      <div class="apartments-grid">
        <% publicApartments.forEach(apt=>{ %>
        <div class="apt-tile <%=apt.debt===0?'clear':'owed'%>">
          <div class="apt-num">דירה <%=apt.id%></div>
          <div class="apt-debt"><%=apt.debt===0?'✓ שולם':'₪'+apt.debt.toLocaleString()%></div>
        </div>
        <% }) %>
      </div>
      <div class="mt-12 text-muted text-small" style="display:flex;gap:18px;flex-wrap:wrap;">
        <span>ללא חוב: <strong style="color:var(--green);"><%= publicApartments.filter(a=>a.debt===0).length %></strong></span>
        <span>עם חוב: <strong style="color:var(--red);"><%= publicApartments.filter(a=>a.debt>0).length %></strong></span>
        <span>חוב כולל: <strong style="color:var(--gold);">₪<%= publicApartments.reduce((s,a)=>s+a.debt,0).toLocaleString() %></strong></span>
      </div>
    </div>
    <% } else { %>
    <div class="card">
      <div class="public-hidden-msg" style="padding:20px 0 16px;">
        🔒 פירוט החובות לפי דירה אינו מוצג באופן ציבורי
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:4px;">
        <div class="fin-card" style="min-width:140px;">
          <div class="fin-val" style="color:var(--red);"><%=publicApartments.filter(a=>a.debt>0).length%></div>
          <div class="fin-lbl">דיירים עם חוב</div>
        </div>
        <div class="fin-card" style="min-width:140px;">
          <div class="fin-val" style="color:var(--gold);">₪<%=publicApartments.reduce((s,a)=>s+a.debt,0).toLocaleString()%></div>
          <div class="fin-lbl">חוב כולל</div>
        </div>
        <div class="fin-card" style="min-width:140px;">
          <div class="fin-val" style="color:var(--green);"><%=publicApartments.filter(a=>a.debt===0).length%></div>
          <div class="fin-lbl">דיירים ללא חוב</div>
        </div>
      </div>
    </div>
    <% } %>
  </section>

  <% if(specialCharges && specialCharges.length > 0){ %>
  <div class="divider"></div>
  <section class="section">
    <h2 class="section-title">גביות מיוחדות</h2>
    <% specialCharges.forEach(sc=>{ const paid=sc.apartments.filter(a=>a.paid).length; const pct=Math.round(paid/20*100); %>
    <div class="project-card">
      <div class="project-header">
        <div class="project-meta">
          <h3><%=sc.name%></h3>
          <%if(sc.description){%><p><%=sc.description%></p><%}%>
          <%if(sc.date){%><p style="color:var(--text-dim);font-size:0.8rem;">תאריך: <%=sc.date%></p><%}%>
        </div>
        <div class="project-stats">
          <div class="project-stat"><div class="stat-val">₪<%=sc.costPerApartment.toLocaleString()%></div><div class="stat-lbl">לדירה</div></div>
          <div class="project-stat"><div class="stat-val" style="color:var(--green);"><%=paid%>/20</div><div class="stat-lbl">שילמו</div></div>
          <div class="project-stat"><div class="stat-val" style="color:<%=pct>=80?'var(--green)':'var(--gold)'%>"><%=pct%>%</div><div class="stat-lbl">גבייה</div></div>
        </div>
      </div>
      <div class="project-progress">
        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width:<%=pct%>%"></div></div>
        <div class="progress-label"><span>התקדמות</span><span><%=paid%>/20</span></div>
      </div>
      <div class="chips-grid">
        <%for(let i=1;i<=20;i++){const p=sc.apartments.find(a=>a.id===i&&a.paid);%>
        <div class="chip <%=p?'paid':'unpaid'%>"><%=p?'✓':'✗'%> דירה <%=i%></div>
        <%}%>
      </div>
    </div>
    <% }) %>
  </section>
  <% } %>

  <% if(showFinancialReport){ %>
  <div class="divider"></div>

  <!-- ══ FINANCIAL REPORT ════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">
      דו"ח פיננסי — מצב הקופה
      <span class="badge <%=balance>=0?'badge-green':'badge-red'%>" style="margin-right:auto;">
        <%= balance >= 0 ? 'מאזן חיובי' : 'מאזן שלילי' %>
      </span>
    </h2>
    <div class="card">

      <!-- Summary: 4 cards including opening balance (balance = ALL time, not just 3 months) -->
      <div class="fin-summary" style="grid-template-columns:repeat(4,1fr);">
        <div class="fin-card">
          <div class="fin-val" style="color:var(--blue);">₪<%=openingBalance.toLocaleString()%></div>
          <div class="fin-lbl">יתרת פתיחה</div>
        </div>
        <div class="fin-card">
          <div class="fin-val" style="color:var(--green);">+₪<%=totalIncome.toLocaleString()%></div>
          <div class="fin-lbl">סה"כ הכנסות</div>
        </div>
        <div class="fin-card">
          <div class="fin-val" style="color:var(--red);">-₪<%=totalExpense.toLocaleString()%></div>
          <div class="fin-lbl">סה"כ הוצאות</div>
        </div>
        <div class="fin-card" style="border:2px solid <%=balance>=0?'rgba(22,163,74,0.4)':'rgba(220,38,38,0.4)'%>;">
          <div class="fin-val" style="color:<%=balance>=0?'var(--gold)':'var(--red)'%>;">
            <%=balance>=0?'+':''%>₪<%=Math.abs(balance).toLocaleString()%>
          </div>
          <div class="fin-lbl" style="font-weight:700;">יתרה נוכחית</div>
        </div>
      </div>
      <p style="font-size:0.74rem;color:var(--text-dim);margin:8px 0 16px;direction:rtl;">
        * היתרה מחושבת על סך כל הפעולות. הטבלה מציגה 3 חודשים אחרונים בלבד.
      </p>

      <!-- Transactions — last 3 months, scrollable -->
      <% if(recentTx && recentTx.length > 0){ %>
      <div style="display:flex;align-items:center;justify-content:space-between;margin:16px 0 10px;flex-wrap:wrap;gap:8px;">
        <div style="font-size:0.8rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;">
          פעולות — 3 חודשים אחרונים
        </div>
        <span class="badge badge-blue" style="font-size:0.72rem;"><%=recentTx.length%> פעולות</span>
      </div>
      <div style="overflow-y:auto;max-height:280px;border-radius:var(--radius-sm);border:1px solid var(--border);">
        <table class="tx-table" style="margin:0;">
          <thead style="position:sticky;top:0;z-index:1;">
            <tr>
              <th>תאריך</th>
              <th>קטגוריה</th>
              <th>תיאור</th>
              <th>סכום</th>
              <th>סוג</th>
            </tr>
          </thead>
          <tbody>
            <% recentTx.forEach(tx=>{ %>
            <tr>
              <td style="white-space:nowrap;color:var(--text-muted);font-size:0.8rem;"><%=tx.date||'—'%></td>
              <td><%=tx.category||'—'%></td>
              <td><%=tx.description||'—'%></td>
              <td class="tx-type-<%=tx.type%>"><%=tx.type==='income'?'+':'-'%>₪<%=(tx.amount||0).toLocaleString()%></td>
              <td><span class="badge <%=tx.type==='income'?'badge-green':'badge-red'%>"><%=tx.type==='income'?'הכנסה':'הוצאה'%></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p class="text-muted" style="text-align:center;padding:24px 0;font-size:0.88rem;">
        אין פעולות ב-3 החודשים האחרונים
      </p>
      <% } %>
    </div>
  </section>
  <% } %>

  <div class="divider"></div>

  <!-- ══ PAYMENT ════════════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">תשלום מהיר לוועד הבית</h2>
    <div class="card">
      <div class="payment-section">
        <div class="bank-detail-box">
          <div class="bank-header">פרטי בנק</div>
          <%[['בנק',bankDetails.bank],['סניף',bankDetails.branch],['חשבון',bankDetails.account],['שם',bankDetails.beneficiary]].forEach(([l,v])=>{%>
          <div class="bank-row">
            <span class="bank-val"><%=v%></span>
            <span class="bank-label"><%=l%></span>
          </div>
          <%})%>
        </div>
        <div class="payment-actions">
          <button class="btn btn-primary" id="copy-bank-btn">📋 העתק פרטי בנק</button>
          <a href="<%=payboxLink%>" target="_blank" rel="noopener" class="btn btn-outline">💳 תשלום בPayBox</a>
        </div>
      </div>
    </div>
  </section>

</main>
<div class="toast" id="toast"></div>

<script>
const bankDetails = <%- JSON.stringify(bankDetails) %>;

// ── THEME ──────────────────────────────────────────────────────────────────
function applyTheme(mode){
  document.body.classList.toggle('light', mode==='light');
  document.documentElement.classList.toggle('pre-light', mode==='light');
  const i=document.getElementById('theme-icon'), l=document.getElementById('theme-label');
  if(i) i.textContent=mode==='light'?'☀️':'🌙';
  if(l) l.textContent=mode==='light'?'בהיר':'כהה';
  localStorage.setItem('vaad_theme', mode);
}
// Apply immediately
applyTheme(localStorage.getItem('vaad_theme')||'light');

document.getElementById('theme-toggle-btn').addEventListener('click',()=>{
  applyTheme(document.body.classList.contains('light')?'dark':'light');
});

// ── TOAST ─────────────────────────────────────────────────────────────────
function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className=`toast show ${type}`;
  setTimeout(()=>{ t.className='toast'; }, 3200);
}

// ── RENDER PERSONAL ────────────────────────────────────────────────────────
function renderPersonal(apt){
  document.getElementById('personal-area').style.display='block';
  document.getElementById('pa-num').textContent=apt.id;
  // Show owner/tenant info
  const ownerEl=document.getElementById('pa-owner');
  if(apt.ownerType==='tenant' && apt.tenantName){
    ownerEl.innerHTML=`
      <span style="font-size:0.78rem;color:var(--text-muted);">בעלים: ${apt.ownerName||'—'}</span><br>
      <span style="font-weight:700;">שוכר: ${apt.tenantName}</span>
      <span style="margin-right:6px;background:rgba(245,158,11,0.15);border:1px solid rgba(245,158,11,0.35);color:#d97706;padding:2px 8px;border-radius:50px;font-size:0.72rem;font-weight:700;">🔑 שכירות</span>`;
  } else {
    ownerEl.innerHTML=`${apt.ownerName||`דירה ${apt.id}`}
      <span style="margin-right:6px;background:var(--blue-dim);border:1px solid rgba(99,102,241,0.3);color:var(--blue);padding:2px 8px;border-radius:50px;font-size:0.72rem;font-weight:700;">🏠 בעלים</span>`;
  }

  const badge=document.getElementById('pa-debt-badge');
  if(apt.debt===0){
    badge.className='debt-badge zero mt-8';
    badge.innerHTML='✓ אין חוב — הכל מסודר';
  } else {
    badge.className='debt-badge has-debt mt-8';
    badge.innerHTML=`⚠ חוב כולל: ₪${apt.debt.toLocaleString()}`;
  }

  const bk=document.getElementById('pa-breakdown');
  if(apt.debt>0){
    let p=[];
    if(apt.monthlyDebt>0) p.push(`ועד חודשי: ₪${apt.monthlyDebt.toLocaleString()}`);
    if(apt.specialDebt>0) p.push(`גביות מיוחדות: ₪${apt.specialDebt.toLocaleString()}`);
    bk.textContent=p.join(' | '); bk.style.display='block';
  } else bk.style.display='none';

  const noteEl=document.getElementById('pa-note');
  if(apt.note){ noteEl.textContent=apt.note; noteEl.style.display='block'; }
  else noteEl.style.display='none';

  // monthly grid
  const grid=document.getElementById('pa-monthly-grid');
  grid.innerHTML='';
  let yr='';
  apt.monthlyStatus.forEach(m=>{
    if(m.year!==yr){
      if(yr) grid.insertAdjacentHTML('beforeend','</div>');
      grid.insertAdjacentHTML('beforeend',`<div class="year-label">${m.year}</div><div class="month-row">`);
      yr=m.year;
    }
    const cls=m.state==='full'?'paid':m.state==='partial'?'partial':'unpaid';
    const icon=m.state==='full'?'✓':m.state==='partial'?'~':'✗';
    const sub=m.state==='partial'?`<span class="month-sub">₪${m.paidAmount}/₪${m.fullAmount}</span>`:'';
    grid.insertAdjacentHTML('beforeend',`
      <div class="month-chip ${cls}" title="${m.label}">
        <span class="month-icon">${icon}</span>
        <span class="month-name">${m.label.split(' ')[0]}</span>${sub}
      </div>`);
  });
  if(yr) grid.insertAdjacentHTML('beforeend','</div>');

  // special charges
  const spSec=document.getElementById('pa-special-section');
  const spList=document.getElementById('pa-special-list');
  spList.innerHTML='';
  if(apt.specialCharges && apt.specialCharges.length>0){
    spSec.style.display='block';
    apt.specialCharges.forEach(sc=>{
      spList.insertAdjacentHTML('beforeend',`
        <div class="special-row">
          <div>
            <strong>${sc.name}</strong>
            ${sc.description?`<span class="text-muted"> — ${sc.description}</span>`:''}
          </div>
          <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
            <span style="font-weight:700;">₪${sc.costPerApartment.toLocaleString()}</span>
            <span class="chip ${sc.paid?'paid':'unpaid'}">${sc.paid?'✓ שולם':'✗ לא שולם'}</span>
          </div>
        </div>`);
    });
  } else spSec.style.display='none';
}

function showHeaderLogout(show){
  document.getElementById('header-logout-btn').style.display = show ? 'inline-flex' : 'none';
}

function doLogout(){
  localStorage.removeItem('vaad_v2_apt');
  localStorage.removeItem('vaad_v2_pass');
  document.getElementById('personal-area').style.display='none';
  document.getElementById('login-card').style.display='block';
  document.getElementById('apt-select').value='';
  document.getElementById('apt-password').value='';
  document.getElementById('pa-phonebook-section').style.display='none';
  document.getElementById('pa-phonebook-list').innerHTML='';
  showHeaderLogout(false);
  showToast('יצאת מהמערכת');
}

// ── LOGIN TYPE TOGGLE ─────────────────────────────────────────────────────
let loginType = 'tenant';
function setLoginType(type){
  loginType = type;
  document.getElementById('type-tenant').classList.toggle('active', type==='tenant');
  document.getElementById('type-admin').classList.toggle('active', type==='admin');
  document.getElementById('tenant-fields').style.display = type==='tenant' ? 'block' : 'none';
  document.getElementById('admin-fields').style.display  = type==='admin'  ? 'block' : 'none';
  document.getElementById('login-error').style.display   = 'none';
  // focus first input
  setTimeout(()=>{
    const inp = type==='tenant'
      ? document.getElementById('apt-select')
      : document.getElementById('admin-password');
    if(inp) inp.focus();
  }, 50);
}

// ── LOGIN ─────────────────────────────────────────────────────────────────
async function doLogin(){
  const errEl = document.getElementById('login-error');
  errEl.style.display = 'none';
  const btn = document.getElementById('login-btn');
  btn.disabled = true; btn.textContent = '...';

  try {
    if(loginType === 'admin'){
      const pass = document.getElementById('admin-password').value;
      if(!pass){ errEl.style.display='block'; errEl.textContent='הזן סיסמת מנהל.'; return; }
      const r = await fetch('/api/admin/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pass})});
      const d = await r.json();
      if(d.success){
        // Store password in sessionStorage so admin page auto-logs in
        sessionStorage.setItem('vaad_admin_pass', pass);
        window.location.href = '/admin';
      } else {
        errEl.style.display='block'; errEl.textContent='סיסמת מנהל שגויה.';
      }
    } else {
      const aptId = document.getElementById('apt-select').value;
      const pass  = document.getElementById('apt-password').value;
      if(!aptId||!pass){ errEl.style.display='block'; errEl.textContent='אנא בחר דירה והזן סיסמה.'; return; }
      const r = await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apartmentId:aptId,password:pass})});
      const d = await r.json();
      if(d.success){
        errEl.style.display='none';
        localStorage.setItem('vaad_v2_apt', aptId);
        localStorage.setItem('vaad_v2_pass', pass);
        document.getElementById('login-card').style.display='none';
        renderPersonal(d.apartment);
        loadPhonebook(aptId, pass);
        showHeaderLogout(true);
        showToast(`ברוך הבא, דירה ${aptId}!`);
      } else {
        errEl.style.display='block'; errEl.textContent=d.message||'שגיאה';
      }
    }
  }catch(e){ errEl.style.display='block'; errEl.textContent='שגיאת רשת'; }
  finally{ btn.disabled=false; btn.textContent='כניסה'; }
}

// ── AUTO LOGIN ────────────────────────────────────────────────────────────
async function tryAutoLogin(){
  localStorage.removeItem('vaad_apt'); localStorage.removeItem('vaad_pass');
  const aptId = localStorage.getItem('vaad_v2_apt');
  const pass  = localStorage.getItem('vaad_v2_pass');
  if(!aptId||!pass) return;
  try{
    const r=await fetch('/api/apartment-status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apartmentId:aptId,password:pass})});
    const d=await r.json();
    if(d.success){
      document.getElementById('apt-select').value=aptId;
      document.getElementById('login-card').style.display='none';
      renderPersonal(d.apartment);
      loadPhonebook(aptId, pass);
      showHeaderLogout(true);
    } else {
      localStorage.removeItem('vaad_v2_apt'); localStorage.removeItem('vaad_v2_pass');
    }
  }catch(e){}
}

document.getElementById('login-btn').addEventListener('click', doLogin);
document.getElementById('apt-password').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });
document.getElementById('admin-password').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });
document.getElementById('logout-btn').addEventListener('click', doLogout);
document.getElementById('header-logout-btn').addEventListener('click', doLogout);

// ⚡ Run auto-login — uses NEW key only, so old sessions never fire
tryAutoLogin();

// ── PHONEBOOK ─────────────────────────────────────────────────────────────
async function loadPhonebook(aptId, pass){
  try{
    const r = await fetch('/api/phonebook',{method:'POST',headers:{'Content-Type':'application/json'},
      body: JSON.stringify({apartmentId: aptId, password: pass})});
    const d = await r.json();
    if(!d.success || !d.phonebook.length) return;

    const sec  = document.getElementById('pa-phonebook-section');
    const list = document.getElementById('pa-phonebook-list');
    sec.style.display = 'block';
    list.innerHTML = '';

    d.phonebook.forEach(apt=>{
      const name = apt.ownerType==='tenant' && apt.tenantName
        ? `${apt.ownerName} <span style="color:var(--text-muted);font-size:0.8rem;">(שוכר: ${apt.tenantName})</span>`
        : apt.ownerName || `דירה ${apt.id}`;
      const phone = apt.phone
        ? `<a href="tel:${apt.phone}" style="color:var(--blue);font-weight:700;text-decoration:none;">${apt.phone}</a>`
        : '<span style="color:var(--text-dim);font-size:0.82rem;">אין טלפון</span>';
      list.insertAdjacentHTML('beforeend',`
        <div style="display:flex;align-items:center;justify-content:space-between;padding:9px 0;
             border-bottom:1px solid var(--border);gap:12px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="background:var(--bg2);border:1px solid var(--border);border-radius:6px;
                  width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;
                  font-size:0.78rem;font-weight:700;color:var(--text-muted);flex-shrink:0;">${apt.id}</span>
            <span>${name}</span>
          </div>
          <span>${phone}</span>
        </div>`);
    });

    // last row no border
    const rows = list.querySelectorAll('div');
    if(rows.length) rows[rows.length-1].style.borderBottom='none';

  }catch(e){}
}

document.getElementById('print-phonebook-btn').addEventListener('click',()=>{
  const list = document.getElementById('pa-phonebook-list');
  const win  = window.open('','_blank','width=600,height=800');
  const dir  = document.documentElement.getAttribute('dir')||'rtl';
  win.document.write(`<!DOCTYPE html><html dir="${dir}"><head>
    <meta charset="UTF-8">
    <title>ספר טלפונים — <%=buildingName%></title>
    <style>
      body{font-family:Arial,sans-serif;direction:rtl;padding:24px;color:#111;}
      h2{font-size:1.2rem;margin-bottom:4px;}
      p{color:#666;font-size:0.85rem;margin-bottom:20px;}
      table{width:100%;border-collapse:collapse;font-size:0.9rem;}
      th{background:#f0f0f0;padding:9px 12px;text-align:right;border-bottom:2px solid #ddd;}
      td{padding:8px 12px;border-bottom:1px solid #eee;}
      a{color:#333;text-decoration:none;}
      @media print{@page{margin:15mm;}}
    </style>
  </head><body>
    <h2>📞 ספר טלפונים — <%=buildingName%></h2>
    <p><%=buildingAddress%></p>
    <table>
      <thead><tr><th>#</th><th>שם</th><th>טלפון</th></tr></thead>
      <tbody>`);
  document.querySelectorAll('#pa-phonebook-list > div').forEach(row=>{
    const cells = row.querySelectorAll('div,span');
    const numEl  = row.querySelector('span[style*="width:32px"]');
    const nameEl = row.querySelectorAll('div > span')[1];
    const phoneEl= row.querySelectorAll('div + span')[0] || row.querySelector('a');
    const num   = numEl   ? numEl.textContent.trim()   : '';
    const name  = nameEl  ? nameEl.textContent.trim()  : '';
    const phone = phoneEl ? phoneEl.textContent.trim() : '';
    win.document.write(`<tr><td>${num}</td><td>${name}</td><td><a href="tel:${phone}">${phone||'—'}</a></td></tr>`);
  });
  win.document.write(`</tbody></table><p style="margin-top:20px;font-size:0.75rem;color:#999;">
    הודפס: ${new Date().toLocaleDateString('he-IL')}</p><script src="/js/a11y.js"></script>
</body></html>`);
  win.document.close();
  win.focus();
  setTimeout(()=>win.print(), 400);
});
