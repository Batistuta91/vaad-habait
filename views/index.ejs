<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= buildingName %> — ועד בית</title>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    // Apply theme before render to prevent flash
    if(localStorage.getItem('vaad_theme')==='light') document.documentElement.classList.add('pre-light');
  </script>
  <style>.pre-light body, html.pre-light body { background:#f5f6fa !important; }</style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🏢</div>
      <div class="logo-text">
        <%= buildingName %>
        <span><%= buildingAddress %></span>
      </div>
    </div>
    <nav class="header-nav" style="display:flex;align-items:center;gap:10px;">
      <button class="theme-toggle" id="theme-toggle-btn" aria-label="החלף ערכת צבעים">
        <span id="theme-icon">🌙</span>
        <div class="toggle-track"><div class="toggle-thumb"></div></div>
        <span id="theme-label">כהה</span>
      </button>
      <a href="/admin">כניסת ועד →</a>
    </nav>
  </div>
</header>

<div class="page-hero">
  <h1>שקיפות <span>פיננסית</span> לכולם</h1>
  <p>מצב חוב עדכני • היסטוריית תשלומים • תשלום נוח</p>
</div>

<main class="container" style="padding-bottom:80px;">

  <!-- ══ LOGIN ══════════════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">כניסה לאזור האישי שלך</h2>
    <div class="login-card" id="login-card">
      <div class="login-row">
        <div class="form-group">
          <label for="apt-select">מספר דירה</label>
          <select id="apt-select">
            <option value="">— בחר דירה —</option>
            <% for (let i=1;i<=20;i++) { %><option value="<%= i %>">דירה <%= i %></option><% } %>
          </select>
        </div>
        <div class="form-group">
          <label for="apt-password">סיסמה</label>
          <input type="password" id="apt-password" placeholder="הזן סיסמה">
        </div>
        <div class="form-group" style="flex:none;">
          <label style="visibility:hidden;">כניסה</label>
          <button class="btn btn-primary" id="login-btn">כניסה</button>
        </div>
      </div>
      <div id="login-error" class="form-error" style="display:none;"></div>
    </div>

    <!-- PERSONAL AREA -->
    <div id="personal-area" style="display:none;" class="mt-16">

      <!-- top bar -->
      <div class="personal-card">
        <div class="apt-badge" id="pa-num">?</div>
        <div class="personal-info">
          <div class="apt-label" id="pa-owner"></div>
          <div id="pa-debt-badge" class="debt-badge zero mt-8">✓ אין חוב</div>
          <div class="debt-breakdown mt-8" id="pa-breakdown" style="display:none;font-size:0.82rem;color:var(--text-muted);"></div>
          <div class="apt-note mt-12" id="pa-note" style="display:none;"></div>
        </div>
        <button class="btn btn-ghost btn-sm" id="logout-btn">↩ יציאה</button>
      </div>

      <!-- monthly history -->
      <div class="card mt-16">
        <h3 class="section-title" style="font-size:1rem;">היסטוריית תשלומים חודשיים</h3>
        <div id="pa-monthly-grid" class="monthly-grid"></div>
      </div>

      <!-- special charges for this apt -->
      <div id="pa-special-section" style="display:none;" class="card mt-16">
        <h3 class="section-title" style="font-size:1rem;">גביות מיוחדות</h3>
        <div id="pa-special-list"></div>
      </div>

    </div>
  </section>

  <div class="divider"></div>

  <!-- ══ PUBLIC TABLE ════════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">
      שקיפות ציבורית — סטטוס כל הדירות
      <span class="badge badge-gold" style="margin-right:auto;">מידע עדכני</span>
    </h2>
    <div class="card">
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px;font-size:0.82rem;">
        <span style="color:var(--green);">● ירוק = ללא חוב</span>
        <span style="color:var(--red);">● אדום = יש חוב</span>
        <span class="text-muted" style="margin-right:auto;">מספרי דירות בלבד, ללא פרטים אישיים</span>
      </div>
      <div class="apartments-grid">
        <% publicApartments.forEach(apt => { %>
        <div class="apt-tile <%= apt.debt===0?'clear':'owed' %>">
          <div class="apt-num">דירה <%= apt.id %></div>
          <div class="apt-debt"><%= apt.debt===0 ? '✓ שולם' : '₪'+apt.debt.toLocaleString() %></div>
        </div>
        <% }) %>
      </div>
      <div class="mt-16 text-muted text-small" style="display:flex;gap:20px;flex-wrap:wrap;">
        <span>ללא חוב: <strong style="color:var(--green);"><%= publicApartments.filter(a=>a.debt===0).length %></strong></span>
        <span>עם חוב: <strong style="color:var(--red);"><%= publicApartments.filter(a=>a.debt>0).length %></strong></span>
        <span>חוב כולל: <strong style="color:var(--gold);">₪<%= publicApartments.reduce((s,a)=>s+a.debt,0).toLocaleString() %></strong></span>
      </div>
    </div>
  </section>

  <% if (specialCharges && specialCharges.length > 0) { %>
  <div class="divider"></div>
  <!-- ══ SPECIAL CHARGES PUBLIC ══════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">גביות מיוחדות</h2>
    <% specialCharges.forEach(sc => {
      const paid = sc.apartments.filter(a=>a.paid).length;
      const pct  = Math.round(paid/20*100);
    %>
    <div class="project-card">
      <div class="project-header">
        <div class="project-meta">
          <h3><%= sc.name %></h3>
          <% if(sc.description){ %><p><%= sc.description %></p><% } %>
          <% if(sc.date){ %><p style="color:var(--text-dim);font-size:0.8rem;">תאריך: <%= sc.date %></p><% } %>
        </div>
        <div class="project-stats">
          <div class="project-stat"><div class="stat-val">₪<%= sc.costPerApartment.toLocaleString() %></div><div class="stat-lbl">לדירה</div></div>
          <div class="project-stat"><div class="stat-val" style="color:var(--green);"><%= paid %>/20</div><div class="stat-lbl">שילמו</div></div>
          <div class="project-stat"><div class="stat-val" style="color:<%= pct>=80?'var(--green)':'var(--gold)' %>"><%= pct %>%</div><div class="stat-lbl">גבייה</div></div>
        </div>
      </div>
      <div class="project-progress">
        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width:<%= pct %>%"></div></div>
        <div class="progress-label"><span>התקדמות</span><span><%= paid %>/20</span></div>
      </div>
      <div class="chips-grid">
        <% for(let i=1;i<=20;i++){
          const isPaid=sc.apartments.find(a=>a.id===i&&a.paid); %>
        <div class="chip <%= isPaid?'paid':'unpaid' %>"><%= isPaid?'✓':'✗' %> דירה <%= i %></div>
        <% } %>
      </div>
    </div>
    <% }) %>
  </section>
  <% } %>

  <div class="divider"></div>

  <!-- ══ PAYMENT ════════════════════════════════════════════════════════ -->
  <section class="section">
    <h2 class="section-title">תשלום מהיר לוועד הבית</h2>
    <div class="card">
      <div class="payment-section">
        <div class="bank-detail-box">
          <div style="font-size:0.78rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px;">פרטי בנק</div>
          <% [['בנק',bankDetails.bank],['סניף',bankDetails.branch],['חשבון',bankDetails.account],['שם',bankDetails.beneficiary]].forEach(([l,v])=>{ %>
          <div class="bank-row"><span class="bank-label"><%= l %></span><span class="bank-val"><%= v %></span></div>
          <% }) %>
        </div>
        <div class="payment-actions">
          <button class="btn btn-primary" id="copy-bank-btn">📋 העתק פרטי בנק</button>
          <a href="<%= payboxLink %>" target="_blank" rel="noopener" class="btn btn-outline">💳 תשלום בPayBox</a>
        </div>
      </div>
    </div>
  </section>

</main>

<div class="toast" id="toast"></div>

<script>
const bankDetails = <%- JSON.stringify(bankDetails) %>;

// ═══ THEME ══════════════════════════════════════════════════════════════════
(function(){
  const saved = localStorage.getItem('vaad_theme') || 'dark';
  applyTheme(saved);
})();
function applyTheme(mode){
  document.body.classList.toggle('light', mode==='light');
  const icon  = document.getElementById('theme-icon');
  const label = document.getElementById('theme-label');
  if(icon)  icon.textContent  = mode==='light' ? '☀️' : '🌙';
  if(label) label.textContent = mode==='light' ? 'בהיר' : 'כהה';
  localStorage.setItem('vaad_theme', mode);
}
document.getElementById('theme-toggle-btn').addEventListener('click',()=>{
  const isLight = document.body.classList.contains('light');
  applyTheme(isLight ? 'dark' : 'light');
});

function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg; t.className=`toast show ${type}`;
  setTimeout(()=>{t.className='toast';},3200);
}

// ── AUTH ──────────────────────────────────────────────────────────────────
function renderPersonal(apt){
  document.getElementById('personal-area').style.display='block';
  document.getElementById('pa-num').textContent = apt.id;
  document.getElementById('pa-owner').textContent = apt.ownerName || `דירה ${apt.id}`;

  const badge = document.getElementById('pa-debt-badge');
  if(apt.debt===0){
    badge.className='debt-badge zero mt-8';
    badge.innerHTML='✓ אין חוב — הכל מסודר';
  } else {
    badge.className='debt-badge has-debt mt-8';
    badge.innerHTML=`⚠ חוב כולל: ₪${apt.debt.toLocaleString()}`;
  }

  const breakdown = document.getElementById('pa-breakdown');
  if(apt.debt>0){
    let parts=[];
    if(apt.monthlyDebt>0) parts.push(`ועד חודשי: ₪${apt.monthlyDebt.toLocaleString()}`);
    if(apt.specialDebt>0) parts.push(`גביות מיוחדות: ₪${apt.specialDebt.toLocaleString()}`);
    breakdown.textContent = parts.join(' | ');
    breakdown.style.display='block';
  } else {
    breakdown.style.display='none';
  }

  const noteEl = document.getElementById('pa-note');
  if(apt.note){ noteEl.textContent=apt.note; noteEl.style.display='block'; }
  else noteEl.style.display='none';

  // Monthly grid
  const grid = document.getElementById('pa-monthly-grid');
  grid.innerHTML='';
  let yearGroup='';
  apt.monthlyStatus.forEach(m=>{
    if(m.year!==yearGroup){
      if(yearGroup) grid.insertAdjacentHTML('beforeend','</div>');
      grid.insertAdjacentHTML('beforeend',`<div class="year-label">${m.year}</div><div class="month-row">`);
      yearGroup=m.year;
    }
    const stateClass = m.state==='full' ? 'paid' : m.state==='partial' ? 'partial' : 'unpaid';
    const icon = m.state==='full' ? '✓' : m.state==='partial' ? '~' : '✗';
    const sub  = m.state==='partial' ? `<span class="month-sub">₪${m.paidAmount} / ₪${m.fullAmount}</span>` : '';
    grid.insertAdjacentHTML('beforeend',`
      <div class="month-chip ${stateClass}" title="${m.label}">
        <span class="month-icon">${icon}</span>
        <span class="month-name">${m.label.split(' ')[0]}</span>
        ${sub}
      </div>`);
  });
  if(yearGroup) grid.insertAdjacentHTML('beforeend','</div>');

  // Special charges
  const spSec  = document.getElementById('pa-special-section');
  const spList = document.getElementById('pa-special-list');
  spList.innerHTML='';
  if(apt.specialCharges && apt.specialCharges.length>0){
    spSec.style.display='block';
    apt.specialCharges.forEach(sc=>{
      spList.insertAdjacentHTML('beforeend',`
        <div class="special-row ${sc.paid?'paid':'unpaid'}">
          <div>
            <strong>${sc.name}</strong>
            ${sc.description?`<span class="text-muted"> — ${sc.description}</span>`:''}
          </div>
          <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
            <span style="font-weight:700;">₪${sc.costPerApartment.toLocaleString()}</span>
            <span class="chip ${sc.paid?'paid':'unpaid'}">${sc.paid?'✓ שולם':'✗ לא שולם'}</span>
          </div>
        </div>`);
    });
  } else {
    spSec.style.display='none';
  }
}

async function doLogin(){
  const aptId=document.getElementById('apt-select').value;
  const pass =document.getElementById('apt-password').value;
  const errEl=document.getElementById('login-error');
  if(!aptId||!pass){ errEl.style.display='block'; errEl.textContent='אנא בחר דירה והזן סיסמה.'; return; }
  const btn=document.getElementById('login-btn');
  btn.disabled=true; btn.textContent='...';
  try{
    const r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apartmentId:aptId,password:pass})});
    const d=await r.json();
    if(d.success){
      errEl.style.display='none';
      localStorage.setItem('vaad_apt',aptId);
      localStorage.setItem('vaad_pass',pass);
      renderPersonal(d.apartment);
      showToast(`ברוך הבא, דירה ${aptId}!`);
    } else {
      errEl.style.display='block'; errEl.textContent=d.message||'שגיאה';
    }
  }catch(e){ errEl.style.display='block'; errEl.textContent='שגיאת רשת'; }
  finally{ btn.disabled=false; btn.textContent='כניסה'; }
}

async function tryAutoLogin(){
  const aptId=localStorage.getItem('vaad_apt');
  const pass =localStorage.getItem('vaad_pass');
  if(!aptId||!pass) return;
  try{
    const r=await fetch('/api/apartment-status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apartmentId:aptId,password:pass})});
    const d=await r.json();
    if(d.success){ document.getElementById('apt-select').value=aptId; renderPersonal(d.apartment); }
    else{ localStorage.removeItem('vaad_apt'); localStorage.removeItem('vaad_pass'); }
  }catch(e){}
}

document.getElementById('login-btn').addEventListener('click',doLogin);
document.getElementById('apt-password').addEventListener('keydown',e=>{ if(e.key==='Enter') doLogin(); });
document.getElementById('logout-btn').addEventListener('click',()=>{
  localStorage.removeItem('vaad_apt'); localStorage.removeItem('vaad_pass');
  document.getElementById('personal-area').style.display='none';
  document.getElementById('apt-select').value='';
  document.getElementById('apt-password').value='';
  showToast('יצאת מהמערכת');
});

tryAutoLogin();

document.getElementById('copy-bank-btn').addEventListener('click',()=>{
  const txt=`פרטי בנק ועד הבית\nבנק: ${bankDetails.bank}\nסניף: ${bankDetails.branch}\nחשבון: ${bankDetails.account}\nשם: ${bankDetails.beneficiary}`;
  navigator.clipboard.writeText(txt).then(()=>showToast('פרטי הבנק הועתקו ✓')).catch(()=>showToast('העתק ידנית','error'));
});
</script>
</body>
</html>
